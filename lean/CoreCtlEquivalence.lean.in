import Metronome.CoreCtl
import Metronome.CoreQueue
import Std.Tactic.BVDecide

/-!
# The elaborated core-control cones against `Metronome.CoreCtl`

Generated by `lean/corectl_check.py` from the Yosys RTLIL of
`{{TOP}}`.  Three cones are extracted as Lean functions of named free inputs and
proved equal to the specification in `Metronome.CoreCtl`:

* `rtlWcw` is `w_cw = `PICKG(DG_CW)` (the `CW` write group), a function of the
  move enables, the group bus, the destination bus and the data bus;
* `rtlFreezeStep` is the `frz` / `freeze` / `frzd` register triple, a function of
  reset, the `DBG` write strobe and the host data byte;
* `rtlSticky` and `rtlDbgWrite` are the two host address strobes
  `c_wr_stk` and `d_wr_dbg`, functions of the host write strobe and address.

The last section instantiates `Metronome.CoreQueue`'s theorems with these
definitions, so the queue's `CW.D` / `CW.AL` / `CW.AH` decode and its `CWOVR`
clear become statements about issued moves and host writes.

What stays free: the core pipeline that produces `mv_en` (dispatch, guards and
the freeze gate inside `md2_core`), the destination-to-group map `DG_MAP`, the
host link that produces `h_wr` / `ha` / `h_wd`, `cfg_core_issue` and
`cw_is_cfg`.  Those are per-cycle inputs here; `cw_is_cfg` is proved by the
address-decode cut and `cfg_core_issue` by the arbiter cut.
-/

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Metronome.CoreCtl

-- Generated from Yosys RTLIL. SHA-256 of the RTL snapshot: {{FINGERPRINT}}

/-- `DG_CW` from the generated host map: the write group of the `CW` ports. -/
abbrev dgCw : BitVec 5 := {{DG_CW}}

/-- `D_CW_AL` from `md2_defs.vh`. -/
abbrev dCwAL : BitVec 6 := {{D_CW_AL}}

/-- `D_CW_AH` from `md2_defs.vh`. -/
abbrev dCwAH : BitVec 6 := {{D_CW_AH}}

/-- `D_CW_D` from `md2_defs.vh`. -/
abbrev dCwD : BitVec 6 := {{D_CW_D}}

/-- `HA_CTRL_BASE + HO_CTRL_STICKY`: the `CTRL.STICKY` byte of the host map. -/
abbrev stickyAddr : BitVec 16 := {{STICKY_ADDR}}

/-- `HA_CTRL_BASE` from the host map: the start of the `CTRL` window. -/
abbrev ctrlBase : Nat := {{CTRL_BASE}}

/-- `HSPAN_CTRL` from the host map: the span of the `CTRL` window. -/
abbrev ctrlSpan : Nat := {{CTRL_SPAN}}

/-- `HO_CTRL_STICKY` from the host map: the `STICKY` offset inside `CTRL`. -/
abbrev ctrlOffset : Nat := {{CTRL_OFFSET}}

/-- `HA_DBG_BASE + HO_DBG_DBG`: the `DBG.DBG` byte of the host map. -/
abbrev dbgAddr : BitVec 16 := {{DBG_ADDR}}

/-- `HA_DBG_BASE` from the host map: the start of the `DBG` window. -/
abbrev dbgBase : Nat := {{DBG_BASE}}

/-- `HSPAN_DBG` from the host map: the span of the `DBG` window. -/
abbrev dbgSpan : Nat := {{DBG_SPAN}}

/-- `HO_DBG_DBG` from the host map: the `DBG` offset inside `DBG`. -/
abbrev dbgOffset : Nat := {{DBG_OFFSET}}

/-- The elaborated decode agrees with the generated host map and with SPEC_V2
§13.1's destination codes: each strobe's offset lies inside its window, and
`D_CW_AL`, `D_CW_AH`, `D_CW_D` are 58, 59 and 60. -/
theorem codes_spec : ctrlOffset < ctrlSpan ∧ dbgOffset < dbgSpan ∧
    dCwAL = 58 ∧ dCwAH = 59 ∧ dCwD = 60 := by
  decide

/-! ## The `CW` write-group pick -/

/-- The picked `CW` group word `w_cw`, from the elaborated `pick`/`hits` cone.
`en` is `mv_en`, `grp` the six `grp` buses, `dst` the six `c_dst` fields and
`dat` the six `c_dat` fields. -/
def rtlWcw (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) :
    BitVec 15 :=
{{WCW_LINES}}
  {{WCW_EXPR}}

/-- The extracted `we` bit is exactly "some enabled move's destination is in
group `DG_CW`". -/
theorem rtlWcw_we (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) :
    wordWE (rtlWcw en grp dst dat) = anyContender (bundle en grp dst dat) dgCw := by
  simp only [rtlWcw, wordWE, bitAt, anyContender, contenderAt, bundle, dgCw, slice]
  bv_decide

/-- The extracted destination field is the priority chain's: the first
contender's `c_dst`. -/
theorem rtlWcw_dst (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) :
    wordDst (rtlWcw en grp dst dat) = (word (bundle en grp dst dat) dgCw).dst := by
  simp only [rtlWcw, wordDst, slice, word, chain, anyContender, contenderAt, bundle, dgCw,
    bitAt]
  bv_decide

/-- The extracted data field is the priority chain's: the first contender's
`c_dat`. -/
theorem rtlWcw_data (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) :
    wordData (rtlWcw en grp dst dat) = (word (bundle en grp dst dat) dgCw).data := by
  simp only [rtlWcw, wordData, slice, word, chain, anyContender, contenderAt, bundle, dgCw,
    bitAt]
  bv_decide

/-- The whole extracted word is the specification's packed group word. -/
theorem rtlWcw_eq_pack (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) :
    rtlWcw en grp dst dat = (word (bundle en grp dst dat) dgCw).pack := by
  rw [← makeWord_fields (rtlWcw en grp dst dat), rtlWcw_we, rtlWcw_dst, rtlWcw_data]
  rfl

/-- No enabled move targets the `CW` group: `w_cw` is zero, so the queue sees
neither `CW.D` nor `CW.AL` nor `CW.AH`. -/
theorem rtlWcw_none (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (h0 : contenderAt (bundle en grp dst dat).m0 dgCw = false)
    (h1 : contenderAt (bundle en grp dst dat).m1 dgCw = false)
    (h2 : contenderAt (bundle en grp dst dat).m2 dgCw = false)
    (h3 : contenderAt (bundle en grp dst dat).m3 dgCw = false)
    (h4 : contenderAt (bundle en grp dst dat).m4 dgCw = false)
    (h5 : contenderAt (bundle en grp dst dat).m5 dgCw = false) :
    rtlWcw en grp dst dat = 0 := by
  rw [rtlWcw_eq_pack, word_none _ _ h0 h1 h2 h3 h4 h5, GroupWord.pack]
  decide

/-- Exactly one enabled move targets the `CW` group, at move 0: `w_cw` is that
move's `{1, dst, data}`.  The six index theorems cover every unique-hit cycle. -/
theorem rtlWcw_unique_0 (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (hit : contenderAt (bundle en grp dst dat).m0 dgCw = true) :
    rtlWcw en grp dst dat =
      makeWord true (bundle en grp dst dat).m0.dst (bundle en grp dst dat).m0.data := by
  rw [rtlWcw_eq_pack, word_unique_0 _ _ hit, GroupWord.pack]

theorem rtlWcw_unique_1 (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (no0 : contenderAt (bundle en grp dst dat).m0 dgCw = false)
    (hit : contenderAt (bundle en grp dst dat).m1 dgCw = true) :
    rtlWcw en grp dst dat =
      makeWord true (bundle en grp dst dat).m1.dst (bundle en grp dst dat).m1.data := by
  rw [rtlWcw_eq_pack, word_unique_1 _ _ no0 hit, GroupWord.pack]

theorem rtlWcw_unique_2 (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (no0 : contenderAt (bundle en grp dst dat).m0 dgCw = false)
    (no1 : contenderAt (bundle en grp dst dat).m1 dgCw = false)
    (hit : contenderAt (bundle en grp dst dat).m2 dgCw = true) :
    rtlWcw en grp dst dat =
      makeWord true (bundle en grp dst dat).m2.dst (bundle en grp dst dat).m2.data := by
  rw [rtlWcw_eq_pack, word_unique_2 _ _ no0 no1 hit, GroupWord.pack]

theorem rtlWcw_unique_3 (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (no0 : contenderAt (bundle en grp dst dat).m0 dgCw = false)
    (no1 : contenderAt (bundle en grp dst dat).m1 dgCw = false)
    (no2 : contenderAt (bundle en grp dst dat).m2 dgCw = false)
    (hit : contenderAt (bundle en grp dst dat).m3 dgCw = true) :
    rtlWcw en grp dst dat =
      makeWord true (bundle en grp dst dat).m3.dst (bundle en grp dst dat).m3.data := by
  rw [rtlWcw_eq_pack, word_unique_3 _ _ no0 no1 no2 hit, GroupWord.pack]

theorem rtlWcw_unique_4 (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (no0 : contenderAt (bundle en grp dst dat).m0 dgCw = false)
    (no1 : contenderAt (bundle en grp dst dat).m1 dgCw = false)
    (no2 : contenderAt (bundle en grp dst dat).m2 dgCw = false)
    (no3 : contenderAt (bundle en grp dst dat).m3 dgCw = false)
    (hit : contenderAt (bundle en grp dst dat).m4 dgCw = true) :
    rtlWcw en grp dst dat =
      makeWord true (bundle en grp dst dat).m4.dst (bundle en grp dst dat).m4.data := by
  rw [rtlWcw_eq_pack, word_unique_4 _ _ no0 no1 no2 no3 hit, GroupWord.pack]

theorem rtlWcw_unique_5 (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (no0 : contenderAt (bundle en grp dst dat).m0 dgCw = false)
    (no1 : contenderAt (bundle en grp dst dat).m1 dgCw = false)
    (no2 : contenderAt (bundle en grp dst dat).m2 dgCw = false)
    (no3 : contenderAt (bundle en grp dst dat).m3 dgCw = false)
    (no4 : contenderAt (bundle en grp dst dat).m4 dgCw = false)
    (hit : contenderAt (bundle en grp dst dat).m5 dgCw = true) :
    rtlWcw en grp dst dat =
      makeWord true (bundle en grp dst dat).m5.dst (bundle en grp dst dat).m5.data := by
  rw [rtlWcw_eq_pack, word_unique_5 _ _ no0 no1 no2 no3 no4 hit, GroupWord.pack]

/-! ## The freeze registers -/

/-- The `frz`, `freeze` and `frzd` next-state cone from the chip top. -/
def rtlFreezeStep (state : FreezeState) (input : FreezeInput) : FreezeState :=
{{FRZ_LINES}}
  { freeze := {{FREEZE_EXPR}}
    frz := {{FRZ_EXPR}}
    frzd := {{FRZD_EXPR}} }

/-- The extracted freeze transition matches SPEC_V2 §12.3 at every state and
input: reset clears it, a `DBG` write sets `FREEZE = d[0]` and
`FRZ = d[0] && !d[1]`, and without a write `FRZ = FREEZE`. -/
theorem rtlFreezeStep_eq_step (state : FreezeState) (input : FreezeInput) :
    rtlFreezeStep state input = freezeStep state input := by
  apply FreezeState.ext <;>
    (simp only [rtlFreezeStep, freezeStep, freezeBit, stepBit, bitAt] <;> bv_decide)

def rtlFreezeStateAt (inputs : Nat → FreezeInput) (n : Nat) : FreezeState :=
  run (fun s i => rtlFreezeStep s i) inputs freezeReset n

theorem rtlFreezeStateAt_eq (inputs : Nat → FreezeInput) (n : Nat) :
    rtlFreezeStateAt inputs n = stateAt inputs n :=
  run_congr (fun s i => rtlFreezeStep_eq_step s i) inputs freezeReset n

/-- On the extracted registers, `FRZ` is low from reset until the first `DBG`
write that sets its freeze bit. -/
theorem rtl_trace_freeze_low (inputs : Nat → FreezeInput) (n : Nat)
    (noReset : ∀ k, k < n → (inputs k).resetN = true)
    (noTrigger : ∀ k, k < n → ¬ ((inputs k).dbgWrite = true ∧ freezeBit (inputs k) = true)) :
    (rtlFreezeStateAt inputs n).frz = false := by
  rw [rtlFreezeStateAt_eq]
  exact (trace_freeze_low inputs n noReset noTrigger).2

/-- On the extracted registers, a `DBG` write of `0x01` freezes the next cycle. -/
theorem rtl_trace_frz_of_trigger (inputs : Nat → FreezeInput) (m : Nat)
    (reset : (inputs m).resetN = true) (wr : (inputs m).dbgWrite = true)
    (bit : freezeBit (inputs m) = true) (notStep : stepBit (inputs m) = false) :
    (rtlFreezeStateAt inputs (m + 1)).frz = true := by
  rw [rtlFreezeStateAt_eq]
  exact trace_frz_of_trigger inputs m reset wr bit notStep

/-- On the extracted registers, a `STEP` write (`0x03`) runs exactly one cycle. -/
theorem rtl_trace_frz_one_cycle (inputs : Nat → FreezeInput) (m : Nat)
    (reset : (inputs m).resetN = true) (wr : (inputs m).dbgWrite = true)
    (bit : freezeBit (inputs m) = true) (step : stepBit (inputs m) = true)
    (nextReset : (inputs (m + 1)).resetN = true)
    (nextNoWrite : (inputs (m + 1)).dbgWrite = false) :
    (rtlFreezeStateAt inputs (m + 1)).frz = false ∧
      (rtlFreezeStateAt inputs (m + 2)).frz = true := by
  rw [rtlFreezeStateAt_eq, rtlFreezeStateAt_eq]
  exact trace_frz_one_cycle inputs m reset wr bit step nextReset nextNoWrite

/-! ## The host address strobes -/

/-- `c_wr_stk = w_ctl & (o_ctl == HO_CTRL_STICKY)`: the `CTRL.STICKY` write
strobe, from the host write strobe and address. -/
def rtlSticky (wr : Bool) (ha : BitVec 16) : Bool :=
{{STICKY_LINES}}
  {{STICKY_EXPR}}

/-- `d_wr_dbg = w_dbg & (o_dbg == HO_DBG_DBG)`: the `DBG.DBG` write strobe. -/
def rtlDbgWrite (wr : Bool) (ha : BitVec 16) : Bool :=
{{DBG_LINES}}
  {{DBG_EXPR}}

/-- The `h_wd` bit the elaborated `CWOVR` clear selects, read from the
`cw_overrun` next-state term `c_wr_stk & h_wd[k]`. -/
abbrev stickyBit : Nat := {{STICKY_BIT}}

/-- The elaborated clear selects `CTRL.STICKY`'s `CWOVR` bit, 2 (SPEC_V2 §13.1),
so the clear leaf is a write of the documented bit. -/
theorem stickyBit_spec : stickyBit = 2 := by decide

/-- The extracted `CTRL.STICKY` strobe is exactly "a host write to the
`CTRL.STICKY` byte": the block window and offset reduce to one address, because
the offset is inside the window (`codes_spec`). -/
theorem rtlSticky_eq_spec (wr : Bool) (ha : BitVec 16) :
    rtlSticky wr ha = (wr && ha == stickyAddr) := by
  simp only [rtlSticky]
  bv_decide

/-- The `CWOVR` clear leaf `c_wr_stk & h_wd[2]` is the specification's
`CTRL.STICKY`-with-bit-2 clear. -/
theorem rtlStickyLeaf_eq_spec (wr : Bool) (ha : BitVec 16) (hd : BitVec 8) :
    (rtlSticky wr ha && bitAt hd stickyBit) = stickyLeaf wr ha stickyAddr hd := by
  rw [stickyBit_spec, rtlSticky_eq_spec]
  rfl

/-- The extracted `DBG.DBG` strobe is exactly "a host write to `DBG.DBG`". -/
theorem rtlDbgWrite_eq_spec (wr : Bool) (ha : BitVec 16) :
    rtlDbgWrite wr ha = (wr && ha == dbgAddr) := by
  simp only [rtlDbgWrite]
  bv_decide

/-- The freeze cone's write input, built from a host write and address. -/
def hostFreezeInput (resetN : Bool) (wr : Bool) (ha : BitVec 16) (d : BitVec 8) :
    FreezeInput where
  resetN := resetN
  dbgWrite := rtlDbgWrite wr ha
  data := d

theorem hostFreezeInput_reset (resetN : Bool) (wr : Bool) (ha : BitVec 16) (d : BitVec 8) :
    (hostFreezeInput resetN wr ha d).resetN = resetN := rfl

theorem hostFreezeInput_write (resetN : Bool) (wr : Bool) (ha : BitVec 16) (d : BitVec 8) :
    (hostFreezeInput resetN wr ha d).dbgWrite = (wr && ha == dbgAddr) := by
  simp only [hostFreezeInput, rtlDbgWrite_eq_spec]

theorem hostFreezeInput_data (resetN : Bool) (wr : Bool) (ha : BitVec 16) (d : BitVec 8) :
    (hostFreezeInput resetN wr ha d).data = d := rfl

/-- A host write of `0x01` to `DBG.DBG` freezes the cycle after it, on the
extracted registers. -/
theorem rtl_trace_frz_of_host_trigger (wr : Nat → Bool) (ha : Nat → BitVec 16)
    (d : Nat → BitVec 8) (m : Nat)
    (writeOn : wr m = true) (addr : ha m = dbgAddr)
    (bit : bitAt (d m) 0 = true) (notStep : bitAt (d m) 1 = false) :
    (rtlFreezeStateAt (fun k => hostFreezeInput true (wr k) (ha k) (d k)) (m + 1)).frz =
      true := by
  apply rtl_trace_frz_of_trigger
  · rfl
  · show (hostFreezeInput true (wr m) (ha m) (d m)).dbgWrite = true
    rw [hostFreezeInput_write, writeOn, addr]
    simp
  · exact bit
  · exact notStep

/-! ## Composition with the core pending-write queue

`Metronome.CoreQueue`'s `Input` takes the five queue registers' drivers: the
picked `CW` group, `frz`, `cfg_core_issue`, `cw_is_cfg` and the `CTRL.STICKY`
clear leaf.  The definitions below replace the free leaves with the proved
cones, and the theorems lift the queue's decode from "the 15-bit word's field"
to "the winning move's field" and the clear from "a host write strobe" to a host
write of `CTRL.STICKY` with bit 2 set. -/

/-- The queue input with its leaves replaced by the extracted cones. -/
def queueInput (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool) (hd : BitVec 8) :
    CoreQueue.Input where
  resetN := resetN
  cw := rtlWcw en grp dst dat
  frz := fz.frz
  coreIssue := coreIssue
  isCfg := isCfg
  clearSticky := clearSticky
  hostData := hd

theorem queueInput_cw (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool) (hd : BitVec 8) :
    (queueInput en grp dst dat fz resetN coreIssue isCfg clearSticky hd).cw =
      rtlWcw en grp dst dat := rfl

theorem queueInput_frz (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48)
    (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool) (hd : BitVec 8) :
    (queueInput en grp dst dat fz resetN coreIssue isCfg clearSticky hd).frz = fz.frz := rfl

/-- The queue's `CW` decode functions in the specification's field names. -/
theorem cwCode_eq_wordDst (c : BitVec 15) : CoreQueue.cwCode c = wordDst c := rfl

theorem cwData_eq_wordData (c : BitVec 15) : CoreQueue.cwData c = wordData c := rfl

theorem writeData_eq (i : CoreQueue.Input) :
    CoreQueue.writeData i = (wordWE i.cw && (wordDst i.cw == dCwD)) := rfl

theorem writeLow_eq (i : CoreQueue.Input) :
    CoreQueue.writeLow i = (wordWE i.cw && (wordDst i.cw == dCwAL)) := rfl

theorem writeHigh_eq (i : CoreQueue.Input) :
    CoreQueue.writeHigh i = (wordWE i.cw && (wordDst i.cw == dCwAH)) := rfl

/-- The queue's `CW.D` decode is "the winning move's destination is `D_CW_D`". -/
theorem queue_writeData (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36)
    (dat : BitVec 48) (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool)
    (hd : BitVec 8) (hit : anyContender (bundle en grp dst dat) dgCw = true) :
    CoreQueue.writeData (queueInput en grp dst dat fz resetN coreIssue isCfg clearSticky hd) =
      ((word (bundle en grp dst dat) dgCw).dst == dCwD) := by
  rw [writeData_eq]
  simp only [queueInput]
  rw [rtlWcw_we, hit, rtlWcw_dst]
  rfl

/-- The queue's `CW.AL` decode is "the winning move's destination is `D_CW_AL`". -/
theorem queue_writeLow (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36)
    (dat : BitVec 48) (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool)
    (hd : BitVec 8) (hit : anyContender (bundle en grp dst dat) dgCw = true) :
    CoreQueue.writeLow (queueInput en grp dst dat fz resetN coreIssue isCfg clearSticky hd) =
      ((word (bundle en grp dst dat) dgCw).dst == dCwAL) := by
  rw [writeLow_eq]
  simp only [queueInput]
  rw [rtlWcw_we, hit, rtlWcw_dst]
  rfl

/-- The queue's `CW.AH` decode is "the winning move's destination is `D_CW_AH`". -/
theorem queue_writeHigh (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36)
    (dat : BitVec 48) (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool)
    (hd : BitVec 8) (hit : anyContender (bundle en grp dst dat) dgCw = true) :
    CoreQueue.writeHigh (queueInput en grp dst dat fz resetN coreIssue isCfg clearSticky hd) =
      ((word (bundle en grp dst dat) dgCw).dst == dCwAH) := by
  rw [writeHigh_eq]
  simp only [queueInput]
  rw [rtlWcw_we, hit, rtlWcw_dst]
  rfl

/-- The queue's `CW.D` data byte is the winning move's data. -/
theorem queue_cwData (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36)
    (dat : BitVec 48) (fz : FreezeState) (resetN coreIssue isCfg clearSticky : Bool)
    (hd : BitVec 8) :
    CoreQueue.cwData (queueInput en grp dst dat fz resetN coreIssue isCfg clearSticky hd).cw =
      (word (bundle en grp dst dat) dgCw).data := by
  rw [cwData_eq_wordData]
  simp only [queueInput]
  rw [rtlWcw_data]

/-- The queue's `CWOVR` clear leaf, at the queue's own definition. -/
theorem queue_hostClear (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36)
    (dat : BitVec 48) (fz : FreezeState) (resetN coreIssue isCfg : Bool)
    (wr : Bool) (ha : BitVec 16) (hd : BitVec 8) :
    CoreQueue.hostClear
        (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd) =
      stickyLeaf wr ha stickyAddr hd := by
  simp only [CoreQueue.hostClear, CoreQueue.bitAt, bitAt, queueInput, stickyLeaf,
    rtlSticky_eq_spec]

/-- A `CW.D` move that the queue cannot take sets `CWOVR`.  The premise is the
move's own destination, not the queue's 15-bit word. -/
theorem cwD_dropped_sets_overrun (state : CoreQueue.State) (en : BitVec 6)
    (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) (fz : FreezeState)
    (resetN isCfg clearSticky : Bool) (hd : BitVec 8)
    (hit : anyContender (bundle en grp dst dat) dgCw = true)
    (issued : ((word (bundle en grp dst dat) dgCw).dst == dCwD) = true)
    (pending : state.pending = true)
    (blocked : CoreQueue.drain state
      (queueInput en grp dst dat fz resetN false isCfg clearSticky hd) = false)
    (reset : resetN = true) :
    (CoreQueue.step state
      (queueInput en grp dst dat fz resetN false isCfg clearSticky hd)).overrun = true := by
  have write : CoreQueue.writeData
      (queueInput en grp dst dat fz resetN false isCfg clearSticky hd) = true := by
    rw [queue_writeData en grp dst dat fz resetN false isCfg clearSticky hd hit]
    exact issued
  exact (CoreQueue.no_silent_overwrite _ _ pending write blocked reset).2.2

/-- A host write to `CTRL.STICKY` with bit 2 set clears `CWOVR`, through the
queue's own `overrun_cleared` theorem. -/
theorem overrun_cleared_by_sticky (state : CoreQueue.State) (en : BitVec 6)
    (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) (fz : FreezeState)
    (resetN isCfg coreIssue : Bool) (wr : Bool) (ha : BitVec 16) (hd : BitVec 8)
    (hit : anyContender (bundle en grp dst dat) dgCw = true)
    (issued : ((word (bundle en grp dst dat) dgCw).dst == dCwD) = true)
    (accepted : CoreQueue.accept state
      (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd) = true)
    (reset : resetN = true) (writeOn : wr = true) (addr : ha = stickyAddr)
    (bit2 : bitAt hd 2 = true) :
    (CoreQueue.step state
      (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd)).overrun =
        false := by
  have write : CoreQueue.writeData
      (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd) = true := by
    rw [queue_writeData en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd hit]
    exact issued
  have clear : CoreQueue.hostClear
      (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd) = true := by
    rw [queue_hostClear en grp dst dat fz resetN coreIssue isCfg wr ha hd]
    rw [stickyLeaf_spec]
    exact ⟨writeOn, addr, bit2⟩
  exact CoreQueue.overrun_cleared _ _ reset clear write accepted

/-- Away from a `CTRL.STICKY` write with bit 2 set, `CWOVR` stays set: the
queue's `overrun_sticky` with the clear leaf discharged. -/
theorem overrun_sticky_unless_sticky (state : CoreQueue.State) (en : BitVec 6)
    (grp : BitVec 30) (dst : BitVec 36) (dat : BitVec 48) (fz : FreezeState)
    (resetN isCfg coreIssue : Bool) (wr : Bool) (ha : BitVec 16) (hd : BitVec 8)
    (set : state.overrun = true) (noClear : ¬ (wr = true ∧ ha = stickyAddr ∧
      bitAt hd 2 = true)) (reset : resetN = true) :
    (CoreQueue.step state
      (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd)).overrun =
        true := by
  have clear : CoreQueue.hostClear
      (queueInput en grp dst dat fz resetN coreIssue isCfg (rtlSticky wr ha) hd) = false := by
    rw [queue_hostClear en grp dst dat fz resetN coreIssue isCfg wr ha hd]
    by_cases h : stickyLeaf wr ha stickyAddr hd = true
    · exact absurd ((stickyLeaf_spec _ _ _ _).1 h) noClear
    · simpa using h
  exact CoreQueue.overrun_sticky _ _ reset set clear

/-- A frozen machine's queue neither drains nor accepts: the queue theorems hold
with `frz` replaced by the proved freeze register. -/
theorem frozen_queue_holds (state : CoreQueue.State) (en : BitVec 6) (grp : BitVec 30)
    (dst : BitVec 36) (dat : BitVec 48) (fz : FreezeState) (resetN isCfg clearSticky : Bool)
    (hd : BitVec 8) (frozen : fz.frz = true) (pending : state.pending = true)
    (reset : resetN = true) :
    (CoreQueue.step state
        (queueInput en grp dst dat fz resetN false isCfg clearSticky hd)).pending = true ∧
      CoreQueue.drain state
        (queueInput en grp dst dat fz resetN false isCfg clearSticky hd) = false := by
  have held := CoreQueue.frz_holds state
    (queueInput en grp dst dat fz resetN false isCfg clearSticky hd) frozen pending reset
  exact ⟨held.1, held.2.2.2⟩

/-- With the freeze register low, a pending configuration write presents itself
to the arbiter: the queue's `coreValid` premise, with `frz` from the proved
freeze cone. -/
theorem coreValid_of_queue (state : CoreQueue.State) (en : BitVec 6) (grp : BitVec 30)
    (dst : BitVec 36) (dat : BitVec 48) (fz : FreezeState) (resetN coreIssue isCfg : Bool)
    (hd : BitVec 8) (host : Config.Write)
    (pending : state.pending = true) (unfrozen : fz.frz = false) (cfg : isCfg = true) :
    (CoreQueue.arbInput state
        (queueInput en grp dst dat fz resetN coreIssue isCfg false hd) false host).coreValid =
      true := by
  simp [CoreQueue.arbInput, queueInput, pending, unfrozen, cfg]

