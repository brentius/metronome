import Metronome.Transition
import Std.Tactic.BVDecide

/-!
# Data-RAM arbiter, pointer P0 and the host request slot

An independent specification of `src/md2_mem.v` written from the specification
text, with the data-RAM wrapper `src/md2_dmem.v` reduced to the SRAM macro
contract (§6.2: "a read served in cycle `s` has its word at the RAM output
during `s+1`").

## What the specification says

* **SPEC_V2 §6.2.** The data RAM is 512 x 32 bits (2,048 bytes; byte address `a`
  is lane `a[1:0]` of word `a[10:2]`, little-endian). One access per cycle.
  Requesters, in priority order: stream S0, stream S1, pointer P0, host. Each
  holds at most one request, visible to the arbiter in the cycle after it is
  set. A write is performed at the end of the cycle it is served. A read served
  in cycle `s` has its word at the RAM output during `s+1`, and the requester
  loads it at the end of `s+1` (P0: `RDY` visible from `s+2`, as v1). Addresses
  wrap at 2,048 bytes.
* **SPEC v1 §6.1** (referenced by SPEC_V2 §6.1 for `P0`). Pointer state `PTR`
  (11), `D` (8), `RDY`, and one pending request `REQ` (none, fetch, write +
  address + data). `AL: PTR[7:0]' = v`; `AH: PTR[10:8]' = v[2:0]`; both clear
  `RDY` and set `REQ = fetch`. `W: REQ = write(PTR, v); PTR' = PTR + 1;
  RDY' = 0`. `R: PTR' = PTR + 1; RDY' = 0; REQ = fetch`. Setting `REQ` while one
  is pending overwrites it and sets sticky `MEMHAZ`. A write request writes in
  the cycle it is served. A fetch served in cycle `t` reads `mem[PTR]` (PTR as
  of cycle `t`) and loads `D'` at the end of `t+1` with `RDY' = 1`, so `RDY` is
  visible from `t+2`.
* **SPEC v1 §9a.2.** `MEMHAZ` is set only when a pointer (or the host) replaces
  a request that is still unserved at the end of the cycle. A request served in
  cycle `t` may be followed by a new one set in cycle `t` without a hazard.
* **SPEC v1 §9a.3.** If a pointer move that sets a request happens in the cycle
  a fetch is served or in the cycle it lands, `D` loads the landing byte but
  `RDY'` is 0; only the newer request's landing sets `RDY`.
* **SPEC_V2 §9a.4.** The host has one data-RAM request slot; a new host request
  overwrites an unserved one (no flag).
* **SPEC_V2 §9.** A data-RAM read issued in `R` becomes a host request; served
  in `s`, its byte loads the host's `TX` at the end of `s+1`, i.e. from the word
  the RAM presents during `s+1`.
* **SPEC_V2 §12.3.** In a frozen cycle the arbiter serves only the host
  request; streams and the pointer are not served and the pointer makes no
  autonomous update. Landing exception: a stream or pointer read served in the
  last unfrozen cycle `s` has its word captured at the end of `s+1` even if
  `s+1` is frozen (`FRZD` gates the capture exactly once).
* **SPEC_V2 §12.4.** A stream S0 edge-capture push is a **whole-word** write of
  the 32-bit record (all four byte lanes); a normal stream byte write is one
  lane.

## Cycle convention

`stateAt inputs initial n` is the register state during cycle `n`; `inputs n`
is the sampled input of that cycle and `step` moves to cycle `n+1`. The RAM
word presented during a cycle is the input `ramWord` of that cycle: the SRAM
macro itself is a black box, so the timing "read presented in `s` -> word at
the output in `s+1`" is the premise `RamContract` of the landing theorems, not
a proved property.  Every register equation carries `resetN = true`, because
`rst_n` low at the sampled edge clears the registers.

## Encoding

The request codes and the pointer-move select take `md2_mem.v`'s encoding so
that the elaborated registers can be compared bitwise; `rtlStep_eq_step`
(generated by `mem_check.py`) *proves* that the RTL implements the equations
below with this encoding. Nothing in the equations needs code 3: it can only
arise from a power-up state that already holds it (`reqNext_three`), and reset
leaves 0.
-/

set_option autoImplicit false
set_option maxHeartbeats 1600000

namespace Metronome.Mem

/-! ## Encodings (from §6.1 / `md2_mem.v`) -/

/-- Request slot: no request. -/
abbrev RQ_NONE : BitVec 2 := 0
/-- Request slot: a fetch of `PTR`. -/
abbrev RQ_FETCH : BitVec 2 := 1
/-- Request slot: a write of the latched address and data. -/
abbrev RQ_WRITE : BitVec 2 := 2

/-- Pointer move select: `AL` (low address byte). -/
abbrev PS_AL : BitVec 2 := 0
/-- Pointer move select: `AH` (high address byte). -/
abbrev PS_AH : BitVec 2 := 1
/-- Pointer move select: `W` (write). -/
abbrev PS_W : BitVec 2 := 2
/-- Pointer move select: `R` (read). -/
abbrev PS_R : BitVec 2 := 3

/-! ## State, inputs and outputs -/

/-- Arbiter, pointer and host-slot state: the registers of `md2_mem.v`. -/
@[ext] structure State where
  /-- `PTR`: the pointer's byte address. -/
  ptr : BitVec 11
  /-- `REQ`: the pointer's one pending request (`RQ_NONE`/`FETCH`/`WRITE`). -/
  req : BitVec 2
  /-- The write request's address latch. -/
  reqAddr : BitVec 11
  /-- The write request's data latch. -/
  reqData : BitVec 8
  /-- `RDY`: the pointer's data byte is valid. -/
  rdy : Bool
  /-- `D`: the pointer's data byte. -/
  dat : BitVec 8
  /-- A pointer fetch was served in the previous cycle: its word is presented
  by the RAM during this cycle. -/
  land : Bool
  /-- The lane latched with `land` (the served fetch's byte lane). -/
  landLane : BitVec 2
  /-- No pointer move happened in the serve cycle, so this landing may raise
  `RDY` (§9a.3). -/
  landRdy : Bool
  /-- The host request slot is occupied. -/
  hostQ : Bool
  /-- The host request is a write (otherwise a read). -/
  hostWr : Bool
  /-- The host request's byte address. -/
  hostAddr : BitVec 11
  /-- The host request's write byte. -/
  hostData : BitVec 8
  /-- A host read landing is signalled this cycle. -/
  hLand : Bool
  /-- The byte lane of the host landing. -/
  hLane : BitVec 2
  deriving DecidableEq, Repr

/-- Sampled inputs of the arbiter.  `sReq`/`sWe` are the two stream requests
and write strobes (`s_req`, `s_we`), `sAddr` the 2 x 11-bit byte addresses,
`sWd` the 2 x 8-bit write bytes, `s0WWord` the S0 edge-capture record; the
pointer's winning move is `pWe`/`pSel`/`pData`; `ramWord` is the word the SRAM
presents this cycle. -/
structure Input where
  /-- `rst_n` low at the sampled edge. -/
  resetN : Bool
  /-- `FRZ`: this cycle is frozen (§12.3). -/
  frz : Bool
  /-- `FRZD`: the previous cycle was frozen. -/
  frzd : Bool
  /-- The two stream requests, S0 in bit 0. -/
  sReq : BitVec 2
  /-- The two stream write strobes, S0 in bit 0. -/
  sWe : BitVec 2
  /-- The two stream byte addresses (`{S1, S0}`). -/
  sAddr : BitVec 22
  /-- The two stream write bytes (`{S1, S0}`). -/
  sWd : BitVec 16
  /-- S0 requests a whole-word write of `s0WWord` (§12.4). -/
  s0Word : Bool
  /-- The S0 edge-capture record. -/
  s0WWord : BitVec 32
  /-- A pointer move is enabled (the `P0` write group's winner). -/
  pWe : Bool
  /-- The move's select: 0 `AL`, 1 `AH`, 2 `W`, 3 `R`. -/
  pSel : BitVec 2
  /-- The move's data byte. -/
  pData : BitVec 8
  /-- A host request is set this cycle (a new one overwrites an unserved one). -/
  hSet : Bool
  /-- The host request is a write. -/
  hWr : Bool
  /-- The host request's byte address. -/
  hAddr : BitVec 11
  /-- The host request's write byte. -/
  hData : BitVec 8
  /-- The word the SRAM presents this cycle. -/
  ramWord : BitVec 32
  deriving DecidableEq, Repr

/-- The arbiter's combinational outputs plus the registered outputs of the
pointer (`pRdy`, `pDat`) and the host landing strobe (`hLand`). -/
@[ext] structure Outs where
  /-- `s_gnt = {S1, S0}`. -/
  sGnt : BitVec 2
  /-- The RAM write strobe. -/
  mWe : Bool
  /-- The RAM read strobe. -/
  mRen : Bool
  /-- The RAM word address `a[10:2]`. -/
  mAddr : BitVec 9
  /-- The RAM byte-lane enables. -/
  mBe : BitVec 4
  /-- The RAM write data (the byte replicated, or the S0 record). -/
  mWd : BitVec 32
  /-- `MEMHAZ` event: a pointer move replaced an unserved request. -/
  haz : Bool
  /-- The host landing byte, from the word presented this cycle. -/
  hLandD : BitVec 8
  /-- `P0.RDY`. -/
  pRdy : Bool
  /-- `P0.D`. -/
  pDat : BitVec 8
  /-- The host landing strobe. -/
  hLand : Bool
  deriving DecidableEq, Repr

/-- The state left by a sampled reset edge. -/
def resetState : State :=
  { ptr := 0, req := RQ_NONE, reqAddr := 0, reqData := 0, rdy := false, dat := 0,
    land := false, landLane := 0, landRdy := false, hostQ := false, hostWr := false,
    hostAddr := 0, hostData := 0, hLand := false, hLane := 0 }

/-! ## Bit and field helpers -/

/-- Bit 0 of a 2-bit request vector (the S0 request, `s_req[0]`).  Read the way
the arbiter's cone reads it, so the emitted expression compares literally. -/
def bit0 (v : BitVec 2) : Bool := (BitVec.truncate 1 (BitVec.ushiftRight v 0)) != 0

/-- Bit 1 of a 2-bit request vector (the S1 request, `s_req[1]`). -/
def bit1 (v : BitVec 2) : Bool := (BitVec.truncate 1 (BitVec.ushiftRight v 1)) != 0

/-- The low byte address of a stream (`s_addr[10:0]`). -/
def addrLow (v : BitVec 22) : BitVec 11 := BitVec.truncate 11 v

/-- The high byte address of a stream (`s_addr[21:11]`). -/
def addrHigh (v : BitVec 22) : BitVec 11 := BitVec.truncate 11 (BitVec.ushiftRight v 11)

/-- The byte lane `a[1:0]` of a byte address. -/
def lane (a : BitVec 11) : BitVec 2 := BitVec.truncate 2 a

/-- The word address `a[10:2]` of a byte address. -/
def wordAddr (a : BitVec 11) : BitVec 9 := BitVec.truncate 9 (BitVec.ushiftRight a 2)

/-- `k * v` in 32 bits (the byte-lane offset arithmetic of a part-select). -/
def mulC (k : Nat) (v : BitVec 32) : BitVec 32 := v * BitVec.ofNat 32 k

/-- The little-endian shift of byte lane `l`: bit offset `8 * l`. -/
def laneShift (l : BitVec 2) : Nat := (mulC 8 (BitVec.setWidth 32 l)).toNat

/-- Byte lane `l` of a 32-bit word, little-endian (SPEC_V2 §6.2). -/
def byteAt (w : BitVec 32) (l : BitVec 2) : BitVec 8 :=
  BitVec.truncate 8 (BitVec.ushiftRight w (laneShift l))

/-- The same byte written to all four lanes (`{4{byte}}`). -/
def word4 (b : BitVec 8) : BitVec 32 := ((b ++ b) ++ b) ++ b

/-- The one-hot byte-lane enable of lane `l`. -/
def oneHotLane (l : BitVec 2) : BitVec 4 := BitVec.shiftLeft (1 : BitVec 4) l.toNat

/-- `PTR[10:8]`. -/
def ptrHigh (p : BitVec 11) : BitVec 3 := BitVec.truncate 3 (BitVec.ushiftRight p 8)

/-- `PTR[7:0]`. -/
def ptrLow (p : BitVec 11) : BitVec 8 := BitVec.truncate 8 p

/-! ## Arbiter: requests, priority and grants (§6.2, §12.3) -/

/-- S0 requests the RAM this cycle. -/
def s0Req (i : Input) : Bool := bit0 i.sReq

/-- S1 requests the RAM this cycle. -/
def s1Req (i : Input) : Bool := bit1 i.sReq

/-- Some stream requests the RAM this cycle. -/
def streamReq (i : Input) : Bool := i.sReq != 0

/-- The pointer has an unserved request. -/
def pending (s : State) : Bool := s.req != RQ_NONE

/-- The pending pointer request is a write. -/
def writing (s : State) : Bool := s.req == RQ_WRITE

/-- The pending pointer request is a fetch. -/
def fetching (s : State) : Bool := s.req == RQ_FETCH

/-- S0 is served: highest priority, and a frozen cycle serves only the host. -/
def grantS0 (i : Input) : Bool := s0Req i && !i.frz

/-- S1 is served: no S0 request, not frozen. -/
def grantS1 (i : Input) : Bool := !s0Req i && s1Req i && !i.frz

/-- P0 is served: no stream request, a pending request, not frozen. -/
def grantP0 (s : State) (i : Input) : Bool := !streamReq i && pending s && !i.frz

/-- The host is served: lowest priority, and the only requester served while
frozen (§12.3). -/
def grantHost (s : State) (i : Input) : Bool :=
  (i.frz || (!streamReq i && (s.req == RQ_NONE))) && s.hostQ

/-! ## The served access (§6.2: one access per cycle) -/

/-- The byte address the arbiter presents: the served requester's. -/
def byteAddr (s : State) (i : Input) : BitVec 11 :=
  if grantS0 i then addrLow i.sAddr
  else if grantS1 i then addrHigh i.sAddr
  else if grantP0 s i then (if writing s then s.reqAddr else s.ptr)
  else s.hostAddr

/-- The byte the arbiter presents: the served requester's. -/
def writeByte (s : State) (i : Input) : BitVec 8 :=
  if grantS0 i then BitVec.truncate 8 i.sWd
  else if grantS1 i then BitVec.truncate 8 (BitVec.ushiftRight i.sWd 8)
  else if grantP0 s i then s.reqData
  else s.hostData

/-- S0 requests a whole-word write of its record (§12.4). -/
def wholeWord (i : Input) : Bool := grantS0 i && i.s0Word

/-- The RAM write strobe. -/
def mWe (s : State) (i : Input) : Bool :=
  (grantS0 i && bit0 i.sWe) || (grantS1 i && bit1 i.sWe) ||
    (grantP0 s i && writing s) || (grantHost s i && s.hostWr)

/-- The RAM read strobe: any grant that is not a write. -/
def mRen (s : State) (i : Input) : Bool :=
  (grantS0 i || grantS1 i || grantP0 s i || grantHost s i) && !mWe s i

/-- The RAM word address `a[10:2]`. -/
def mAddr (s : State) (i : Input) : BitVec 9 := wordAddr (byteAddr s i)

/-- The RAM byte-lane enables: all four for the S0 record, one for a byte. -/
def mBe (s : State) (i : Input) : BitVec 4 :=
  if wholeWord i then 0xF else oneHotLane (lane (byteAddr s i))

/-- The RAM write data: the S0 record, or the byte replicated to four lanes. -/
def mWd (s : State) (i : Input) : BitVec 32 :=
  if wholeWord i then i.s0WWord else word4 (writeByte s i)

/-- `MEMHAZ` event: a pointer move replaced an unserved request (§9a.2). -/
def haz (s : State) (i : Input) : Bool := i.pWe && pending s && !grantP0 s i

/-- The host landing byte: lane `hLane` of the word presented this cycle. -/
def hLandD (s : State) (i : Input) : BitVec 8 := byteAt i.ramWord s.hLane

/-- The combinational and registered outputs. -/
def outs (s : State) (i : Input) : Outs :=
  { sGnt := (if grantS1 i then (1 : BitVec 1) else 0) ++
      (if grantS0 i then (1 : BitVec 1) else 0)
    mWe := mWe s i
    mRen := mRen s i
    mAddr := mAddr s i
    mBe := mBe s i
    mWd := mWd s i
    haz := haz s i
    hLandD := hLandD s i
    pRdy := s.rdy
    pDat := s.dat
    hLand := s.hLand }

/-! ## Pointer moves -/

/-- `P0.AL`: load the low address byte. -/
def opAl (i : Input) : Bool := i.pWe && (i.pSel == PS_AL)

/-- `P0.AH`: load the high address byte. -/
def opAh (i : Input) : Bool := i.pWe && (i.pSel == PS_AH)

/-- `P0.W`: request a write of `PTR` with the move's byte, and step `PTR`. -/
def opW (i : Input) : Bool := i.pWe && (i.pSel == PS_W)

/-- `P0.R`: request a fetch and step `PTR`. -/
def opR (i : Input) : Bool := i.pWe && (i.pSel == PS_R)

/-! ## Next state -/

/-- `PTR`: `AL` loads the low byte, `AH` the high byte, `W`/`R` step it on
(modulo 2,048 bytes: the 11-bit sum wraps, §6.2). -/
def ptrNext (s : State) (i : Input) : BitVec 11 :=
  if !i.resetN then 0
  else if opAl i then ptrHigh s.ptr ++ i.pData
  else if opAh i then BitVec.truncate 3 i.pData ++ ptrLow s.ptr
  else if opW i || opR i then s.ptr + 1
  else s.ptr

/-- `REQ`: `W` sets a write request, every other move sets a fetch request, a
served request clears; a move replaces an unserved request (§9a.2). -/
def reqNext (s : State) (i : Input) : BitVec 2 :=
  if !i.resetN then RQ_NONE
  else if opW i then RQ_WRITE
  else if i.pWe then RQ_FETCH
  else if grantP0 s i then RQ_NONE
  else s.req

/-- The write request's address latch: `W` latches `PTR` as of the move. -/
def reqAddrNext (s : State) (i : Input) : BitVec 11 :=
  if !i.resetN then 0 else if opW i then s.ptr else s.reqAddr

/-- The write request's data latch. -/
def reqDataNext (s : State) (i : Input) : BitVec 8 :=
  if !i.resetN then 0 else if opW i then i.pData else s.reqData

/-- `RDY`: every move clears it (§6.1), a landing sets it unless a move happened
in the serve cycle (§9a.3), and a frozen landing cycle waits (§12.3). -/
def rdyNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false
  else if i.pWe then false
  else if s.land && s.landRdy && !i.frz then true
  else s.rdy

/-- `D`: load the landing byte once, from the word presented in the cycle after
the serve, including a frozen landing cycle (§12.3 landing exception). -/
def datNext (s : State) (i : Input) : BitVec 8 :=
  if !i.resetN then 0
  else if s.land && !i.frzd then byteAt i.ramWord s.landLane
  else s.dat

/-- Record that a fetch is served, and its lane, so the landing lands next cycle.
A frozen cycle records nothing (§12.3). -/
def landNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false
  else if !i.frz then grantP0 s i && fetching s
  else s.land

/-- The landing's byte lane: `PTR[1:0]` as of the serve cycle. -/
def landLaneNext (s : State) (i : Input) : BitVec 2 :=
  if !i.resetN then 0 else if !i.frz then lane s.ptr else s.landLane

/-- Whether this landing may raise `RDY`: no pointer move in the serve cycle
(§9a.3). -/
def landRdyNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false else if !i.frz then !i.pWe else s.landRdy

/-- The host slot: a new request overwrites an unserved one, a served one
clears (§9a.4, §6.2). -/
def hostQNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false
  else if i.hSet then true
  else if grantHost s i then false
  else s.hostQ

/-- The host request's write flag. -/
def hostWrNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false else if i.hSet then i.hWr else s.hostWr

/-- The host request's address. -/
def hostAddrNext (s : State) (i : Input) : BitVec 11 :=
  if !i.resetN then 0 else if i.hSet then i.hAddr else s.hostAddr

/-- The host request's write byte. -/
def hostDataNext (s : State) (i : Input) : BitVec 8 :=
  if !i.resetN then 0 else if i.hSet then i.hData else s.hostData

/-- The host landing strobe: a served host read lands the following cycle
(§9: "served in `s`, its byte loads `TX` at the end of `s+1`"). -/
def hLandNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false else grantHost s i && !s.hostWr

/-- The landing's byte lane, latched from the served request's address. -/
def hLaneNext (s : State) (i : Input) : BitVec 2 :=
  if !i.resetN then 0 else lane s.hostAddr

/-- The arbiter's transition. -/
def step (s : State) (i : Input) : State :=
  { ptr := ptrNext s i
    req := reqNext s i
    reqAddr := reqAddrNext s i
    reqData := reqDataNext s i
    rdy := rdyNext s i
    dat := datNext s i
    land := landNext s i
    landLane := landLaneNext s i
    landRdy := landRdyNext s i
    hostQ := hostQNext s i
    hostWr := hostWrNext s i
    hostAddr := hostAddrNext s i
    hostData := hostDataNext s i
    hLand := hLandNext s i
    hLane := hLaneNext s i }

/-- A sampled reset edge leaves the reset state. -/
theorem step_reset (s : State) (i : Input) (h : i.resetN = false) :
    step s i = resetState := by
  simp [step, ptrNext, reqNext, reqAddrNext, reqDataNext, rdyNext, datNext,
    landNext, landLaneNext, landRdyNext, hostQNext, hostWrNext, hostAddrNext,
    hostDataNext, hLandNext, hLaneNext, resetState, h]

/-! ## The encoding's fourth code is unreachable -/

/-- A `REQ` code of 3 can only come from a state that already has it. -/
theorem reqNext_three (s : State) (i : Input) (h : reqNext s i = 3) : s.req = 3 := by
  simp only [reqNext, opW, grantP0, streamReq, pending, RQ_NONE, RQ_WRITE,
    RQ_FETCH] at h ⊢
  bv_decide

theorem reqNext_ne (s : State) (i : Input) (h : s.req ≠ 3) : reqNext s i ≠ 3 := by
  intro h3
  exact h (reqNext_three s i h3)

/-! ## One access per cycle, highest priority first (§6.2) -/

/-- An S0 request is served in the cycle it is visible. -/
theorem grantS0_served (i : Input) (h : s0Req i = true) (hf : i.frz = false) :
    grantS0 i = true := by
  simp [grantS0, h, hf]

/-- An S1 request is served in the cycle it is visible when S0 is idle. -/
theorem grantS1_served (i : Input) (h0 : s0Req i = false) (h : s1Req i = true)
    (hf : i.frz = false) : grantS1 i = true := by
  simp [grantS1, h0, h, hf]

/-- A pointer request is served in the cycle it is visible when no stream
requests and the machine is not frozen: **the bounded-wait form**.  A request
set at the end of cycle `t` is visible in `t+1` (`request_set_visible`), so
every pointer request is served at most one cycle after it is set, given no
higher-priority requester. -/
theorem grantP0_served (s : State) (i : Input) (h : pending s = true)
    (hs : streamReq i = false) (hf : i.frz = false) : grantP0 s i = true := by
  simp [grantP0, h, hs, hf]

/-- A host request is served in the cycle it is visible when nobody else wants
the port (or the machine is frozen, §12.3). -/
theorem grantHost_served (s : State) (i : Input) (h : s.hostQ = true)
    (hfree : i.frz = true ∨ (streamReq i = false ∧ s.req = RQ_NONE)) :
    grantHost s i = true := by
  rcases hfree with hf | ⟨hs, hp⟩
  · simp [grantHost, h, hf]
  · simp [grantHost, h, hs, hp, RQ_NONE]

/-- At most one requester is served: every pair of grants is mutually exclusive.
"An S0 grant excludes every other requester" is the first three rows, etc. -/
theorem grants_exclusive (s : State) (i : Input) :
    (grantS0 i && grantS1 i) = false ∧ (grantS0 i && grantP0 s i) = false ∧
      (grantS0 i && grantHost s i) = false ∧ (grantS1 i && grantP0 s i) = false ∧
      (grantS1 i && grantHost s i) = false ∧ (grantP0 s i && grantHost s i) = false := by
  simp only [grantS0, grantS1, grantP0, grantHost, s0Req, s1Req, streamReq, pending,
    bit0, bit1]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> bv_decide

/-- A served pointer request is not also served by the host. -/
theorem grantP0_excludes_host (s : State) (i : Input) (h : grantP0 s i = true) :
    grantHost s i = false := by
  have hpair := (grants_exclusive s i).2.2.2.2.2
  simpa [h] using hpair

/-- An S0 grant excludes the pointer. -/
theorem grantS0_excludes_p0 (s : State) (i : Input) (h : grantS0 i = true) :
    grantP0 s i = false := by
  have hpair := (grants_exclusive s i).2.1
  simpa [h] using hpair

/-- A pointer grant excludes the S0 and S1 grants. -/
theorem grantP0_excludes_s0 (s : State) (i : Input) (h : grantP0 s i = true) :
    grantS0 i = false := by
  have hpair := (grants_exclusive s i).2.1
  simpa [h] using hpair

theorem grantP0_excludes_s1 (s : State) (i : Input) (h : grantP0 s i = true) :
    grantS1 i = false := by
  have hpair := (grants_exclusive s i).2.2.2.1
  simpa [h] using hpair

/-! ## Pointer moves (§6.1, §9a.2, §9a.3) -/

/-- Every pointer move leaves a request pending (so the served-clear path is not
taken), unless a reset edge intervenes. -/
theorem request_set_visible (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opAl i = true ∨ opAh i = true ∨ opW i = true ∨ opR i = true) :
    pending (step s i) = true := by
  have hpwe : i.pWe = true := by
    rcases h with h | h | h | h
    · have := h; simp [opAl] at this; exact this.1
    · have := h; simp [opAh] at this; exact this.1
    · have := h; simp [opW] at this; exact this.1
    · have := h; simp [opR] at this; exact this.1
  simp only [pending, step, reqNext, opW, grantP0, streamReq, RQ_NONE, RQ_WRITE,
    RQ_FETCH] at hreset hpwe ⊢
  bv_decide

/-- `AL` loads `PTR[7:0]`. -/
theorem ptr_al (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opAl i = true) : (step s i).ptr = ptrHigh s.ptr ++ i.pData := by
  simp [step, ptrNext, hreset, h]

/-- `AH` loads `PTR[10:8]`. -/
theorem ptr_ah (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opAh i = true) (hal : opAl i = false) :
    (step s i).ptr = BitVec.truncate 3 i.pData ++ ptrLow s.ptr := by
  simp [step, ptrNext, hreset, h, hal]

/-- `W` and `R` step `PTR` by one (wrapping in 11 bits, §6.2). -/
theorem ptr_step (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opW i = true ∨ opR i = true) (hal : opAl i = false) (hah : opAh i = false) :
    (step s i).ptr = s.ptr + 1 := by
  rcases h with h | h
  · simp [step, ptrNext, hreset, h, hal, hah]
  · simp [step, ptrNext, hreset, h, hal, hah]

/-- A write move latches the write request, the address and the byte. -/
theorem write_move (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opW i = true) :
    (step s i).req = RQ_WRITE ∧ (step s i).reqAddr = s.ptr ∧
      (step s i).reqData = i.pData := by
  simp [step, reqNext, reqAddrNext, reqDataNext, hreset, h]

/-- A write move clears `RDY` (§6.1). -/
theorem write_move_rdy (s : State) (i : Input) (hreset : i.resetN = true)
    (hpwe : i.pWe = true) : (step s i).rdy = false := by
  simp [step, rdyNext, hreset, hpwe]

/-- `R` leaves a fetch request and clears `RDY`. -/
theorem read_move (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opR i = true) : (step s i).req = RQ_FETCH ∧ (step s i).rdy = false := by
  have hpwe : i.pWe = true := by have := h; simp [opR] at this; exact this.1
  have hsel : i.pSel = 3 := by have := h; simp [opR] at this; exact this.2
  have hw : opW i = false := by simp [opW, hpwe, hsel]
  constructor
  · simp [step, reqNext, hreset, hpwe, hw]
  · simp [step, rdyNext, hreset, hpwe]

/-- `AL`/`AH` also clear `RDY` and leave a fetch request (§6.1). -/
theorem byte_load_request (s : State) (i : Input) (hreset : i.resetN = true)
    (h : opAl i = true ∨ opAh i = true) :
    (step s i).req = RQ_FETCH ∧ (step s i).rdy = false := by
  have hpwe : i.pWe = true := by
    rcases h with h | h
    · have := h; simp [opAl] at this; exact this.1
    · have := h; simp [opAh] at this; exact this.1
  have hw : opW i = false := by
    rcases h with h | h
    · have h2 := h; simp [opAl] at h2; simp [opW, h2.1, h2.2]
    · have h2 := h; simp [opAh] at h2; simp [opW, h2.1, h2.2]
  constructor
  · simp [step, reqNext, hreset, hpwe, hw]
  · simp [step, rdyNext, hreset, hpwe]

/-- A move that replaces an unserved request raises `MEMHAZ` (§9a.2). -/
theorem haz_replaced (s : State) (i : Input) (h : i.pWe = true)
    (hp : pending s = true) (hs : grantP0 s i = false) : haz s i = true := by
  simp [haz, h, hp, hs]

/-- A request the arbiter serves in the same cycle is not replaced "still
unserved", so a move in a serve cycle raises no hazard (§9a.2). -/
theorem no_haz_when_served (s : State) (i : Input) (h : grantP0 s i = true) :
    haz s i = false := by
  simp [haz, h]

/-- The slot holds no request. -/
theorem pending_none (s : State) (h : s.req = RQ_NONE) : pending s = false := by
  simp only [pending]
  rw [h]
  decide

/-- A move that sets a request while nothing is pending raises no hazard
(§9a.2: only a *replaced* request is a hazard). -/
theorem no_haz_without_request (s : State) (i : Input) (h : pending s = false) :
    haz s i = false := by
  simp [haz, h]

/-! ## What the served requester presents (§6.2, §12.4) -/

/-- The served address is the pointer write's latched address. -/
theorem byteAddr_p0_write (s : State) (i : Input) (hg : grantP0 s i = true)
    (hw : writing s = true) : byteAddr s i = s.reqAddr := by
  have h0 := grantP0_excludes_s0 s i hg
  have h1 := grantP0_excludes_s1 s i hg
  simp [byteAddr, h0, h1, hg, hw]

/-- The served address is the pointer fetch's `PTR`. -/
theorem byteAddr_p0_fetch (s : State) (i : Input) (hg : grantP0 s i = true)
    (hw : writing s = false) : byteAddr s i = s.ptr := by
  have h0 := grantP0_excludes_s0 s i hg
  have h1 := grantP0_excludes_s1 s i hg
  simp [byteAddr, h0, h1, hg, hw]

/-- The served byte is the pointer write's latched data. -/
theorem writeByte_p0 (s : State) (i : Input) (hg : grantP0 s i = true) :
    writeByte s i = s.reqData := by
  have h0 := grantP0_excludes_s0 s i hg
  have h1 := grantP0_excludes_s1 s i hg
  simp [writeByte, h0, h1, hg]

/-- The served address is the host request's. -/
theorem byteAddr_host (s : State) (i : Input) (h0 : grantS0 i = false)
    (h1 : grantS1 i = false) (hp : grantP0 s i = false) : byteAddr s i = s.hostAddr := by
  simp [byteAddr, h0, h1, hp]

/-- The served byte is the host request's. -/
theorem writeByte_host (s : State) (i : Input) (h0 : grantS0 i = false)
    (h1 : grantS1 i = false) (hp : grantP0 s i = false) : writeByte s i = s.hostData := by
  simp [writeByte, h0, h1, hp]

/-- A served pointer write presents exactly its latched word: the addressed
word, the addressed byte lane, and the byte replicated to four lanes. -/
theorem served_write_ports (s : State) (i : Input)
    (hg : grantP0 s i = true) (hw : writing s = true) :
    mWe s i = true ∧ mAddr s i = wordAddr s.reqAddr ∧
      mBe s i = oneHotLane (lane s.reqAddr) ∧ mWd s i = word4 s.reqData := by
  have h0 := grantP0_excludes_s0 s i hg
  have h1 := grantP0_excludes_s1 s i hg
  have hnw : wholeWord i = false := by simp [wholeWord, h0]
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [mWe, h0, h1, hg, hw]
  · rw [mAddr, byteAddr_p0_write s i hg hw]
  · simp [mBe, hnw, byteAddr_p0_write s i hg hw]
  · simp [mWd, hnw, writeByte_p0 s i hg]

/-- A served pointer fetch reads the pointer's word and requests its lane. -/
theorem served_fetch_ports (s : State) (i : Input)
    (hg : grantP0 s i = true) (hf : fetching s = true) :
    mRen s i = true ∧ mAddr s i = wordAddr s.ptr ∧
      mBe s i = oneHotLane (lane s.ptr) := by
  have h0 := grantP0_excludes_s0 s i hg
  have h1 := grantP0_excludes_s1 s i hg
  have hgh := grantP0_excludes_host s i hg
  have hw : writing s = false := by
    simp only [writing, fetching] at hf ⊢
    bv_decide
  have hnw : wholeWord i = false := by simp [wholeWord, h0]
  refine ⟨?_, ?_, ?_⟩
  · simp [mWe, mRen, h0, h1, hg, hgh, hw]
  · rw [mAddr, byteAddr_p0_fetch s i hg hw]
  · simp [mBe, hnw, byteAddr_p0_fetch s i hg hw]

/-- A served S0 whole-word write covers all four lanes with the 32-bit record
(§12.4). -/
theorem s0_word_write (s : State) (i : Input) (hg : grantS0 i = true)
    (hw : i.s0Word = true) : mBe s i = 0xF ∧ mWd s i = i.s0WWord := by
  simp [mBe, mWd, wholeWord, hg, hw]

/-- A served byte write enables exactly the addressed byte lane. -/
theorem byte_write_lane (s : State) (i : Input) (hnw : wholeWord i = false) :
    mBe s i = oneHotLane (lane (byteAddr s i)) := by
  simp [mBe, hnw]

/-! ## Landing (§6.2, §9a.3, §12.3) -/

/-- A served fetch records its lane and whether it may raise `RDY`. -/
theorem served_fetch_lands (s : State) (i : Input) (hreset : i.resetN = true)
    (hf : i.frz = false) (hg : grantP0 s i = true) (hfetch : fetching s = true) :
    (step s i).land = true ∧ (step s i).landLane = lane s.ptr ∧
      (step s i).landRdy = !i.pWe := by
  simp [step, landNext, landLaneNext, landRdyNext, hreset, hf, hg, hfetch]

/-- The landing captures the byte of the word presented this cycle. -/
theorem landing_captures (s : State) (i : Input) (hreset : i.resetN = true)
    (hl : s.land = true) (hf : i.frzd = false) :
    (step s i).dat = byteAt i.ramWord s.landLane := by
  simp [step, datNext, hreset, hl, hf]

/-- In a frozen cycle the landing byte is still captured once, from the word the
RAM presents (§12.3 landing exception). -/
theorem frozen_landing_captures (s : State) (i : Input) (hreset : i.resetN = true)
    (hl : s.land = true) (_hfrz : i.frz = true) (hfrzd : i.frzd = false) :
    (step s i).dat = byteAt i.ramWord s.landLane := by
  simp [step, datNext, hreset, hl, hfrzd]

/-- A landing raises `RDY` in the cycle after the serve, unless a pointer move,
a frozen cycle or a move in the serve cycle intervenes (§9a.3, §12.3). -/
theorem landing_sets_rdy (s : State) (i : Input) (hreset : i.resetN = true)
    (hl : s.land = true) (hlr : s.landRdy = true) (hf : i.frz = false)
    (hp : i.pWe = false) : (step s i).rdy = true := by
  simp [step, rdyNext, hreset, hl, hlr, hf, hp]

/-! ## Frozen cycles (§12.3) -/

/-- A frozen cycle serves only the host, and the pointer state holds.  `dat` is
the landing exception: a read served in the last unfrozen cycle is still
captured. -/
theorem frozen_holds (s : State) (i : Input) (hreset : i.resetN = true)
    (hfrz : i.frz = true) (hpwe : i.pWe = false) :
    grantS0 i = false ∧ grantS1 i = false ∧ grantP0 s i = false ∧
      grantHost s i = s.hostQ ∧
      (step s i).ptr = s.ptr ∧ (step s i).req = s.req ∧
      (step s i).reqAddr = s.reqAddr ∧ (step s i).reqData = s.reqData ∧
      (step s i).rdy = s.rdy ∧ (step s i).land = s.land ∧
      (step s i).landLane = s.landLane ∧ (step s i).landRdy = s.landRdy ∧
      (step s i).dat =
        (if s.land && !i.frzd then byteAt i.ramWord s.landLane else s.dat) := by
  simp [grantS0, grantS1, grantP0, grantHost, step, ptrNext, reqNext, reqAddrNext,
    reqDataNext, rdyNext, datNext, landNext, landLaneNext, landRdyNext, hreset,
    hfrz, hpwe, opAl, opAh, opW, opR]

/-- A frozen cycle's RAM access is the host request or nothing. -/
theorem frozen_access_is_host (s : State) (i : Input) (hreset : i.resetN = true)
    (hfrz : i.frz = true) (hpwe : i.pWe = false) :
    mWe s i = (s.hostQ && s.hostWr) ∧ mRen s i = (s.hostQ && !s.hostWr) ∧
      mAddr s i = wordAddr s.hostAddr := by
  obtain ⟨h0, h1, hp, hgh, -⟩ := frozen_holds s i hreset hfrz hpwe
  have hba := byteAddr_host s i h0 h1 hp
  refine ⟨?_, ?_, ?_⟩
  · simp [mWe, h0, h1, hp, hgh]
  · simp [mRen, mWe, h0, h1, hp, hgh]
    bv_decide
  · rw [mAddr, hba]

/-! ## Traces -/

/-- The register state during cycle `n`. -/
def stateAt (inputs : Nat → Input) (initial : State) (n : Nat) : State :=
  run (fun s i => step s i) inputs initial n

theorem stateAt_succ (inputs : Nat → Input) (initial : State) (n : Nat) :
    stateAt inputs initial (n + 1) = step (stateAt inputs initial n) (inputs n) := rfl

theorem stateAt_reset (inputs : Nat → Input) (initial : State)
    (reset : (inputs 0).resetN = false) : stateAt inputs initial 1 = resetState := by
  rw [stateAt_succ]
  exact step_reset initial (inputs 0) reset

/-- The pointer never takes the illegal request code: from reset it stays in
`{none, fetch, write}` for every input sequence. -/
theorem stateAt_req_ne_three (inputs : Nat → Input) (initial : State)
    (reset : (inputs 0).resetN = false) (n : Nat) :
    (stateAt inputs initial (n + 1)).req ≠ 3 := by
  induction n with
  | zero =>
    rw [stateAt_reset inputs initial reset]
    simp [resetState, RQ_NONE]
  | succ n ih =>
    rw [stateAt_succ]
    exact reqNext_ne _ _ ih

/-- A pointer request set at the end of cycle `n` is pending in cycle `n+1`. -/
theorem trace_request_visible (inputs : Nat → Input) (initial : State) (n : Nat)
    (hreset : (inputs n).resetN = true)
    (h : opAl (inputs n) = true ∨ opAh (inputs n) = true ∨
      opW (inputs n) = true ∨ opR (inputs n) = true) :
    pending (stateAt inputs initial (n + 1)) = true := by
  rw [stateAt_succ]
  exact request_set_visible _ _ hreset h

/-! ## The SRAM macro contract -/

/-- The macro contract used by the landing theorems: the word presented in cycle
`n+1` is the memory content at the address presented in cycle `n`.  The SRAM
macro is a black box (`src/md2_sram_bb.v`), so this is a premise, not a proved
property. -/
def RamContract (ram : BitVec 9 → BitVec 32) (word : Nat → BitVec 32)
    (addr : Nat → BitVec 9) : Prop :=
  ∀ n, word (n + 1) = ram (addr n)

/-- A host read served in cycle `n` lands in `n+1`: the landing strobe is set,
and the landing byte is the served request's lane of the word the RAM presents
in `n+1`.  This is the landing premise of the host read cut
(`Metronome.HostRead`), discharged in terms of the arbiter's RAM word input. -/
theorem trace_host_read_lands (inputs : Nat → Input) (initial : State) (n : Nat)
    (hreset : (inputs n).resetN = true)
    (hserved : grantHost (stateAt inputs initial n) (inputs n) = true)
    (hread : (stateAt inputs initial n).hostWr = false) :
    (stateAt inputs initial (n + 1)).hLand = true ∧
      (stateAt inputs initial (n + 1)).hLane =
        lane (stateAt inputs initial n).hostAddr ∧
      hLandD (stateAt inputs initial (n + 1)) (inputs (n + 1)) =
        byteAt (inputs (n + 1)).ramWord (lane (stateAt inputs initial n).hostAddr) := by
  have hstep : stateAt inputs initial (n + 1) =
      step (stateAt inputs initial n) (inputs n) := stateAt_succ inputs initial n
  refine ⟨?_, ?_, ?_⟩
  · rw [hstep]
    simp [step, hLandNext, hreset, hserved, hread]
  · rw [hstep]
    simp [step, hLaneNext, hreset]
  · rw [hstep]
    simp [hLandD, step, hLaneNext, hreset]

/-- With the macro contract, the host landing byte is the served address's byte
of the data RAM. -/
theorem trace_host_read_data (inputs : Nat → Input) (initial : State) (n : Nat)
    (ram : BitVec 9 → BitVec 32)
    (hram : RamContract ram (fun k => (inputs k).ramWord)
      (fun k => mAddr (stateAt inputs initial k) (inputs k)))
    (hreset : (inputs n).resetN = true)
    (hserved : grantHost (stateAt inputs initial n) (inputs n) = true)
    (hread : (stateAt inputs initial n).hostWr = false) :
    hLandD (stateAt inputs initial (n + 1)) (inputs (n + 1)) =
      byteAt (ram (mAddr (stateAt inputs initial n) (inputs n)))
        (lane (stateAt inputs initial n).hostAddr) := by
  rw [(trace_host_read_lands inputs initial n hreset hserved hread).2.2]
  simp only [hram n]

/-- A pointer fetch served in cycle `n` loads its byte at the end of `n+1` and
makes it visible with `RDY` in cycle `n+2` (§6.2: "P0: RDY visible from
`s+2`").  The premises are the documented exceptions: no pointer move in the
serve cycle or in the landing cycle (§9a.3), no frozen cycle in either
(§12.3), and `FRZD` in the landing cycle is the serve cycle's `FRZ` (which the
freeze cut proves). -/
theorem trace_p0_read_lands (inputs : Nat → Input) (initial : State) (n : Nat)
    (hserved : grantP0 (stateAt inputs initial n) (inputs n) = true)
    (hfetch : fetching (stateAt inputs initial n) = true)
    (hreset : (inputs n).resetN = true) (hreset1 : (inputs (n + 1)).resetN = true)
    (hnofrz : (inputs n).frz = false) (hnopwe : (inputs n).pWe = false)
    (hnofrz1 : (inputs (n + 1)).frz = false)
    (hnopwe1 : (inputs (n + 1)).pWe = false)
    (hfrzd1 : (inputs (n + 1)).frzd = false) :
    (stateAt inputs initial (n + 2)).rdy = true ∧
      (stateAt inputs initial (n + 2)).dat =
        byteAt (inputs (n + 1)).ramWord (lane (stateAt inputs initial n).ptr) := by
  have hn1 : stateAt inputs initial (n + 1) =
      step (stateAt inputs initial n) (inputs n) := stateAt_succ inputs initial n
  have hn2 : stateAt inputs initial (n + 2) =
      step (stateAt inputs initial (n + 1)) (inputs (n + 1)) := by
    rw [show n + 2 = n + 1 + 1 from rfl]
    exact stateAt_succ inputs initial (n + 1)
  obtain ⟨hland, hlanelane, hlandrdy⟩ :=
    served_fetch_lands (stateAt inputs initial n) (inputs n) hreset hnofrz hserved hfetch
  have hland1 : (stateAt inputs initial (n + 1)).land = true := by
    rw [hn1]; exact hland
  have hlane1 : (stateAt inputs initial (n + 1)).landLane =
      lane (stateAt inputs initial n).ptr := by rw [hn1]; exact hlanelane
  have hrdy1 : (stateAt inputs initial (n + 1)).landRdy = true := by
    rw [hn1, hlandrdy, hnopwe]
    rfl
  refine ⟨?_, ?_⟩
  · rw [hn2]
    exact landing_sets_rdy _ _ hreset1 hland1 hrdy1 hnofrz1 hnopwe1
  · rw [hn2, landing_captures _ _ hreset1 hland1 hfrzd1, hlane1]

end Metronome.Mem
