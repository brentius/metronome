import Metronome.Transition
import Metronome.Host
import Metronome.Compose
import Std.Tactic.BVDecide

/-!
# Host SPI command state machine

An independent specification of the command/address/data phase machine of the
host link in `src/md2_host.v`, written from SPEC_V2 §9.  Where
`Metronome.Host` models only the registered write strobe `wr` and the bit
counter `bitc`, this module also models the byte state `st`, the command latch
`is_rd`, the 16-bit address register `addr`, the data register `wdata`, the
read request `rd` and the read-acknowledge flag `rack`.  With those in the
state, `st` and `is_rd` stop being free per-cycle inputs of the host cut.

## What SPEC_V2 §9 says (the equations below)

SPI target, mode 0, MSB first.  `SR` is a synchronised rising edge of `SCK`
while the synchronised `CS_N` is low.  On each `SR`, `RX' = {RX[6:0], MOSI}` and
the bit count increments; on the 8th `SR` of a byte the byte value
`{RX[6:0], MOSI}` completes.  Byte 0 is the command: `0x02` write, `0x03`
read, any other value ignores the rest of the transaction.  Byte 1 is
`ADDR[15:8]`, byte 2 is `ADDR[7:0]`; a read issues a read request at `ADDR` in
the cycle after the byte completes.  Write data bytes issue a host write of the
byte to `ADDR` in the cycle after the byte completes and step `ADDR`; read data
bytes issue a read request at `ADDR` in that cycle.  While `CS_N` is high the
byte state returns to the command byte and the bit count clears.

## Encoding and the `cmd` history variable

SPEC_V2 §9 names the byte states but fixes no encoding.  The `ST_*` constants
below take the encoding of `md2_host.v` so that the state can be compared
bitwise; `rtlStep_eq_step` (generated by `hostcmd_check.py`) *proves* that the
elaborated registers implement these equations with this encoding, so the
encoding is checked against the RTL rather than assumed.

`cmd` is not a register of `md2_host.v`: the RTL keeps only `is_rd`.  It is a
history variable that records the byte that completed in `ST_CMD`, using the
RTL's own command-completion condition.  It exists so that "a write strobe
belongs to a transaction whose command byte was `0x02`" is a statement about
the state of this model.  Its update rule is the same net expression that feeds
the RTL `st` and `is_rd` registers, and `hostcmd_check.py` checks that every
gate in its cone also feeds those two registers.  The theorems that do not need
the command byte (`wr_only_in_data`, `isRd_no_wr`, `not_data_no_wr`,
`cs_high_resets`, the address lemmas) mention no history variable at all.

## Cycle boundary

`stateAt inputs initial n` is the register state during chip cycle `n`, after
`n` sampled edges.  A strobe `wr` in cycle `n` is therefore
`(stateAt inputs initial n).wr`, and it was produced by the sampled edge at the
end of cycle `n-1`.
-/

set_option autoImplicit false
set_option maxHeartbeats 800000

namespace Metronome.HostCmd

/-! ## Byte states and command bytes -/

abbrev ST_CMD : BitVec 3 := 0
abbrev ST_AH : BitVec 3 := 1
abbrev ST_AL : BitVec 3 := 2
abbrev ST_DATA : BitVec 3 := 3
abbrev ST_IGN : BitVec 3 := 4

abbrev CMD_WRITE : BitVec 8 := 0x02
abbrev CMD_READ : BitVec 8 := 0x03

/-- Program state: the registers of the host link that the command machine
reads or writes, plus the `cmd` history variable (see the module comment). -/
structure State where
  /-- Byte state `st`: command, address high, address low, data, ignored. -/
  phase : BitVec 3
  /-- Bit count within the current byte. -/
  bitc : BitVec 3
  /-- Receive shift register `rx`. -/
  rx : BitVec 7
  /-- Command latch `is_rd`: the transaction is a read. -/
  isRd : Bool
  /-- Address register `addr`. -/
  addr : BitVec 16
  /-- Registered write strobe `wr`. -/
  wr : Bool
  /-- Registered write data `wdata`. -/
  wdata : BitVec 8
  /-- Registered read request `rd`. -/
  rd : Bool
  /-- Register-read acknowledgement pending (`rack`). -/
  rack : Bool
  /-- History variable: the last completed command byte. -/
  cmd : BitVec 8
  deriving DecidableEq, Repr

/-- Sampled host-link inputs.  `mosi` is the serial data bit, `rdData` marks a
read of a data-RAM address and `hland` a data-RAM byte landing this cycle. -/
structure Input where
  resetN : Bool
  sck : Bool
  sckPrev : Bool
  csN : Bool
  mosi : Bool
  rdData : Bool
  hland : Bool
  deriving DecidableEq, Repr

/-- The state left by a sampled reset edge (`rst_n` low at the clock). -/
def resetState : State :=
  ⟨ST_CMD, 0, 0, false, 0, false, 0, false, false, 0⟩

/-! ## Combinational terms of SPEC_V2 §9 -/

/-- `CS_N` low selects the link. -/
def cs (i : Input) : Bool := !i.csN

/-- `SR`: a rising `SCK` edge while `CS_N` is low.  Reset is applied separately,
as the RTL's `rst_n` mux does. -/
def sr (i : Input) : Bool := !i.csN && i.sck && !i.sckPrev

/-- The byte value completed by an `SR`: `{RX[6:0], MOSI}`. -/
def byteIn (s : State) (i : Input) : BitVec 8 := s.rx ++ (if i.mosi then (1 : BitVec 1) else 0)

/-- A read acknowledgement lands this cycle: a register-read value is waiting
(`rack`) or a data-RAM byte arrives (`hland`). -/
def ackBit (s : State) (i : Input) : Bool := s.rack || i.hland

/-- The address step of the cycle: the RTL advances `addr` whenever a write
strobe or a read acknowledgement is in that cycle. -/
def addrInc (s : State) (i : Input) : BitVec 16 :=
  if s.wr || ackBit s i then s.addr + 1 else s.addr

/-- The 8th rising edge of a byte. -/
def completing (s : State) (i : Input) : Bool := sr i && (s.bitc == 7)

/-! ## Next state

Each equation is the RTL's assignment order: the unconditional clears first,
then the `CS_N`-high branch, then the `SR` branch with its completing byte. -/

def phaseNext (s : State) (i : Input) : BitVec 3 :=
  if !i.resetN then ST_CMD
  else if i.csN then ST_CMD
  else if completing s i then
    if s.phase == ST_CMD then
      (if byteIn s i == CMD_WRITE || byteIn s i == CMD_READ then ST_AH else ST_IGN)
    else if s.phase == ST_AH then ST_AL
    else if s.phase == ST_AL then ST_DATA
    else s.phase
  else s.phase

def bitcNext (s : State) (i : Input) : BitVec 3 :=
  if !i.resetN then 0
  else if i.csN then 0
  else if sr i then (if s.bitc == 7 then 0 else s.bitc + 1)
  else s.bitc

def rxNext (s : State) (i : Input) : BitVec 7 :=
  if !i.resetN then 0
  else if sr i then (s.rx <<< 1) ||| (if i.mosi then 1 else 0)
  else s.rx

def isRdNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false
  else if completing s i then (if s.phase == ST_CMD then byteIn s i == CMD_READ else s.isRd)
  else s.isRd

def addrNext (s : State) (i : Input) : BitVec 16 :=
  if !i.resetN then 0
  else if completing s i && s.phase == ST_AH then byteIn s i ++ (addrInc s i).truncate 8
  else if completing s i && s.phase == ST_AL then
    (addrInc s i >>> 8).truncate 8 ++ byteIn s i
  else addrInc s i

def wrNext (s : State) (i : Input) : Bool :=
  i.resetN && !i.csN && completing s i && s.phase == ST_DATA && !s.isRd

def wdataNext (s : State) (i : Input) : BitVec 8 :=
  if !i.resetN then 0
  else if !i.csN && completing s i && s.phase == ST_DATA && !s.isRd then byteIn s i
  else s.wdata

def rdNext (s : State) (i : Input) : Bool :=
  i.resetN && !i.csN && completing s i && (s.phase == ST_AL || s.phase == ST_DATA) && s.isRd

def rackNext (s : State) (i : Input) : Bool :=
  if !i.resetN then false else s.rd && !i.rdData

def cmdNext (s : State) (i : Input) : BitVec 8 :=
  if !i.resetN then 0
  else if i.csN then s.cmd
  else if completing s i && s.phase == ST_CMD then byteIn s i
  else s.cmd

def step (s : State) (i : Input) : State :=
  ⟨phaseNext s i, bitcNext s i, rxNext s i, isRdNext s i, addrNext s i,
   wrNext s i, wdataNext s i, rdNext s i, rackNext s i, cmdNext s i⟩

/-! ## One-step facts -/

/-- A write strobe needs the completing edge of a data byte of a write
transaction: reset released, `CS_N` low, a rising `SCK` edge, the last bit of a
byte, `ST_DATA`, and not a read. -/
theorem wr_only_in_data (s : State) (i : Input) (h : (step s i).wr = true) :
    s.phase = ST_DATA ∧ s.bitc = 7 ∧ s.isRd = false ∧
      i.resetN = true ∧ i.csN = false ∧ i.sck = true ∧ i.sckPrev = false := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at h ⊢
  bv_decide

/-- A read transaction never issues a write strobe (SPEC_V2 §9: read data bytes
issue read requests). -/
theorem isRd_no_wr (s : State) (i : Input) (h : s.isRd = true) :
    (step s i).wr = false := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at h ⊢
  bv_decide

/-- A write strobe never occurs in the command byte, an address byte or an
ignored transaction. -/
theorem not_data_no_wr (s : State) (i : Input) (h : s.phase ≠ ST_DATA) :
    (step s i).wr = false := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at h ⊢
  bv_decide

/-- An ignored transaction (`ST_IGN`) stays ignored until `CS_N` high or reset,
and never writes. -/
theorem ign_holds (s : State) (i : Input) (h : s.phase = ST_IGN) (hcs : i.csN = false)
    (hreset : i.resetN = true) : (step s i).phase = ST_IGN ∧ (step s i).wr = false := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at h hcs hreset ⊢
  bv_decide

/-- `CS_N` high returns the byte state to the command byte and clears the bit
count; the other registers keep their unconditional next value. -/
theorem cs_high_resets (s : State) (i : Input) (h : i.csN = true) :
    (step s i).phase = ST_CMD ∧ (step s i).bitc = 0 := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at h ⊢
  bv_decide

/-- A sampled reset edge leaves `resetState`, whatever the prior values. -/
theorem reset_step (s : State) (i : Input) (h : i.resetN = false) :
    step s i = resetState := by
  simp only [step, resetState, phaseNext, bitcNext, rxNext, isRdNext, addrNext,
    wrNext, wdataNext, rdNext, rackNext, cmdNext, State.mk.injEq] at h ⊢
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> bv_decide

/-- The command byte completes: `0x02`/`0x03` enter the address bytes, anything
else ignores the rest of the transaction, and `is_rd` latches the read
command. -/
theorem cmd_completion (s : State) (i : Input) (h : s.phase = ST_CMD) (hbitc : s.bitc = 7)
    (hreset : i.resetN = true) (hcs : i.csN = false) (hsck : i.sck = true)
    (hsp : i.sckPrev = false) :
    (step s i).phase =
        (if byteIn s i == CMD_WRITE || byteIn s i == CMD_READ then ST_AH else ST_IGN) ∧
      (step s i).isRd = (byteIn s i == CMD_READ) ∧ (step s i).cmd = byteIn s i ∧
      (step s i).bitc = 0 := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at h hbitc hreset hcs hsck hsp ⊢
  bv_decide

/-- `ADDR[15:8]`: the high byte completes with the byte and the low byte from
the (possibly incremented) register. -/
theorem ah_completion (s : State) (i : Input) (h : s.phase = ST_AH) (hbitc : s.bitc = 7)
    (hreset : i.resetN = true) (hcs : i.csN = false) (hsck : i.sck = true)
    (hsp : i.sckPrev = false) :
    (step s i).phase = ST_AL ∧
      (step s i).addr = byteIn s i ++ (addrInc s i).truncate 8 := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at h hbitc hreset hcs hsck hsp ⊢
  bv_decide

/-- `ADDR[7:0]`: the low byte completes and the transaction enters the data
bytes; a read latches its read request in the following cycle. -/
theorem al_completion (s : State) (i : Input) (h : s.phase = ST_AL) (hbitc : s.bitc = 7)
    (hreset : i.resetN = true) (hcs : i.csN = false) (hsck : i.sck = true)
    (hsp : i.sckPrev = false) :
    (step s i).phase = ST_DATA ∧
      (step s i).addr = (addrInc s i >>> 8).truncate 8 ++ byteIn s i ∧
      (step s i).rd = s.isRd := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at h hbitc hreset hcs hsck hsp ⊢
  bv_decide

/-- A write data byte issues the write strobe, presents the byte and clears the
bit count; a read data byte issues a read request instead. -/
theorem data_completion (s : State) (i : Input) (h : s.phase = ST_DATA) (hbitc : s.bitc = 7)
    (hreset : i.resetN = true) (hcs : i.csN = false) (hsck : i.sck = true)
    (hsp : i.sckPrev = false) :
    (step s i).bitc = 0 ∧ (step s i).phase = ST_DATA ∧
      ((step s i).wr = (if s.isRd then false else true) ∧
        (step s i).wdata = (if s.isRd then s.wdata else byteIn s i)) ∧
      (step s i).rd = s.isRd := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at h hbitc hreset hcs hsck hsp ⊢
  bv_decide

/-- In a strobe cycle the address register advances by exactly one at the end
of the cycle, so the next data byte of the transaction is one address higher.
The write strobe can only be in `ST_DATA` (see `wr_only_in_data`), and the
address and data bytes cannot strobe. -/
theorem wr_addr_step (s : State) (i : Input) (hwr : s.wr = true)
    (hreset : i.resetN = true) (hah : s.phase ≠ ST_AH) (hal : s.phase ≠ ST_AL) :
    (step s i).addr = s.addr + 1 := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at hwr hreset hah hal ⊢
  bv_decide

/-- The address register only advances on a write strobe, a register-read
acknowledgement or a data-RAM landing; `CS_N` and the byte state do not move
it. -/
theorem addr_holds (s : State) (i : Input) (hwr : s.wr = false) (hack : ackBit s i = false)
    (hreset : i.resetN = true) (hah : s.phase ≠ ST_AH) (hal : s.phase ≠ ST_AL) :
    (step s i).addr = s.addr := by
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at hwr hack hreset hah hal ⊢
  bv_decide

/-! ## The write strobe belongs to a `0x02` transaction

`cmd` records the byte that completed in `ST_CMD`.  `Tagged` is the reachable
invariant that makes it meaningful inside a transaction: in the address and data
states the command byte is one of the two accepted commands, and `is_rd` is
exactly "the command was `0x03`". -/

def Tagged (s : State) : Prop :=
  (s.phase = ST_AH ∨ s.phase = ST_AL ∨ s.phase = ST_DATA) →
    (s.cmd = CMD_WRITE ∨ s.cmd = CMD_READ) ∧ s.isRd = (s.cmd == CMD_READ)

theorem tagged_resetState : Tagged resetState := by
  simp only [Tagged, resetState]
  bv_decide

/-- The invariant is preserved by every sampled edge. -/
theorem tagged_step (s : State) (i : Input) (h : Tagged s) : Tagged (step s i) := by
  simp only [Tagged] at h ⊢
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
  bv_decide

/-! ## Traces -/

def stateAt (inputs : Nat → Input) (initial : State) (n : Nat) : State :=
  run (fun s i => step s i) inputs initial n

theorem stateAt_succ (inputs : Nat → Input) (initial : State) (n : Nat) :
    stateAt inputs initial (n + 1) = step (stateAt inputs initial n) (inputs n) := rfl

/-- A sampled reset edge at cycle 0 leaves the reset state. -/
theorem stateAt_one_reset (inputs : Nat → Input) (initial : State)
    (reset : (inputs 0).resetN = false) : stateAt inputs initial 1 = resetState := by
  rw [stateAt_succ]
  exact reset_step initial (inputs 0) reset

theorem tagged_stateAt (inputs : Nat → Input) (initial : State) (n : Nat)
    (h : Tagged (stateAt inputs initial 1)) : Tagged (stateAt inputs initial (n + 1)) := by
  induction n with
  | zero => exact h
  | succ n ih => rw [stateAt_succ]; exact tagged_step _ _ ih

/-- A write strobe in cycle `n+1` belongs to a transaction whose command byte is
`0x02`; this needs the sampled reset that opened the trace, which makes the
invariant hold from cycle 1 on. -/
theorem trace_wr_cmd (inputs : Nat → Input) (initial : State) (n : Nat)
    (reset : (inputs 0).resetN = false)
    (hwr : (stateAt inputs initial (n + 1)).wr = true) :
    (stateAt inputs initial (n + 1)).cmd = CMD_WRITE := by
  rcases n with _ | m
  · -- cycle 1 is the reset state, which has no write strobe
    exfalso
    rw [stateAt_one_reset inputs initial reset] at hwr
    simp [resetState] at hwr
  · have produced := wr_only_in_data (stateAt inputs initial (m + 1)) (inputs (m + 1))
      (by rw [← stateAt_succ inputs initial (m + 1)]; exact hwr)
    obtain ⟨hphase, _hbitc, hisrd, hreset, hcs, _hsck, _hsp⟩ := produced
    have hold : (stateAt inputs initial (m + 2)).cmd = (stateAt inputs initial (m + 1)).cmd := by
      rw [stateAt_succ]
      simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at hphase hreset hcs ⊢
      bv_decide
    have tagged : Tagged (stateAt inputs initial (m + 1)) :=
      tagged_stateAt inputs initial m (by
        rw [stateAt_one_reset inputs initial reset]; exact tagged_resetState)
    rw [hold]
    simp only [Tagged] at tagged
    have inside := tagged (by right; right; exact hphase)
    obtain ⟨hvalues, hread⟩ := inside
    bv_decide

/-- A write strobe in cycle `n+1` is in `ST_DATA` and is not a read. -/
theorem trace_wr_only_in_data (inputs : Nat → Input) (initial : State) (n : Nat)
    (hwr : (stateAt inputs initial (n + 1)).wr = true) :
    (stateAt inputs initial (n + 1)).phase = ST_DATA ∧
      (stateAt inputs initial (n + 1)).isRd = false := by
  have produced := wr_only_in_data (stateAt inputs initial n) (inputs n) (by
    rw [← stateAt_succ]; exact hwr)
  obtain ⟨hphase, _hbitc, hisrd, _hreset, _hcs, _hsck, _hsp⟩ := produced
  rw [stateAt_succ]
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc] at hphase hisrd ⊢
  bv_decide

/-- A sampled `CS_N` high edge returns the byte state to the command byte. -/
theorem trace_cs_high (inputs : Nat → Input) (initial : State) (n : Nat)
    (hcs : (inputs n).csN = true) :
    (stateAt inputs initial (n + 1)).phase = ST_CMD ∧
      (stateAt inputs initial (n + 1)).bitc = 0 := by
  rw [stateAt_succ]
  exact cs_high_resets _ _ hcs

/-- A strobe cycle advances the address register by one. -/
theorem trace_wr_addr_step (inputs : Nat → Input) (initial : State) (n : Nat)
    (hwr : (stateAt inputs initial (n + 1)).wr = true)
    (hreset : (inputs (n + 1)).resetN = true) :
    (stateAt inputs initial (n + 2)).addr = (stateAt inputs initial (n + 1)).addr + 1 := by
  have inside := trace_wr_only_in_data inputs initial n hwr
  rw [show n + 2 = n + 1 + 1 from rfl, stateAt_succ]
  exact wr_addr_step _ _ hwr hreset (by rw [inside.1]; decide) (by rw [inside.1]; decide)

/-! ## One data byte later: the next strobe is at the next address

A data byte takes eight rising edges.  Between two strobes the address only
moves on a read acknowledgement, so a write burst without one advances by one
per strobe.  `MidByte` is the state partway through a data byte. -/

/-- Partway through a data byte: `c` bits counted, no strobe, address `a`. -/
def MidByte (t : State) (c : BitVec 3) (a : BitVec 16) : Prop :=
  t.phase = ST_DATA ∧ t.isRd = false ∧ t.bitc = c ∧ t.wr = false ∧ t.addr = a

/-- The first rising edge after a strobe cycle enters the data byte. -/
theorem strobe_enters_midByte (t : State) (i : Input) (hphase : t.phase = ST_DATA)
    (hisrd : t.isRd = false) (hbitc : t.bitc = 0) (hwr : t.wr = true)
    (hreset : i.resetN = true) (hsr : sr i = true) :
    MidByte (step t i) 1 (t.addr + 1) := by
  simp only [MidByte, step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at hphase hisrd hbitc hwr hreset hsr ⊢
  bv_decide

/-- A further rising edge before the last bit of the byte. -/
theorem midByte_step (t : State) (i : Input) (c : BitVec 3) (a : BitVec 16) (hc : c ≠ 7)
    (h : MidByte t c a) (hreset : i.resetN = true) (hsr : sr i = true)
    (hack : ackBit t i = false) : MidByte (step t i) (c + 1) a := by
  obtain ⟨hphase, hisrd, hbitc, hwr, haddr⟩ := h
  simp only [MidByte, step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at hphase hisrd hbitc hwr haddr hc hreset hsr hack ⊢
  bv_decide

/-- The eighth rising edge completes a write data byte: the strobe recurs at the
next address and the byte count restarts. -/
theorem midByte_complete (t : State) (i : Input) (a : BitVec 16)
    (h : MidByte t 7 a) (hreset : i.resetN = true) (hsr : sr i = true)
    (hack : ackBit t i = false) :
    (step t i).wr = true ∧ (step t i).addr = a ∧ (step t i).phase = ST_DATA ∧
      (step t i).isRd = false ∧ (step t i).bitc = 0 := by
  obtain ⟨hphase, hisrd, hbitc, hwr, haddr⟩ := h
  simp only [step, phaseNext, bitcNext, rxNext, isRdNext, addrNext, wrNext,
    wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit, addrInc]
    at hphase hisrd hbitc hwr haddr hreset hsr hack ⊢
  bv_decide

/-- One strobe cycle plus the eight rising edges of the following data byte
produce the next strobe, one address higher. -/
theorem next_data_strobe (inputs : Nat → Input) (s : State)
    (hphase : s.phase = ST_DATA) (hisrd : s.isRd = false) (hbitc : s.bitc = 0)
    (hwr : s.wr = true)
    (hcyc : ∀ j, j < 8 → (inputs j).resetN = true ∧ sr (inputs j) = true)
    (hack : ∀ j, 0 < j → j < 8 → ackBit (stateAt inputs s j) (inputs j) = false) :
    (stateAt inputs s 8).wr = true ∧ (stateAt inputs s 8).addr = s.addr + 1 ∧
      (stateAt inputs s 8).phase = ST_DATA ∧ (stateAt inputs s 8).isRd = false ∧
      (stateAt inputs s 8).bitc = 0 := by
  have h0 : MidByte (step (stateAt inputs s 0) (inputs 0)) 1 (s.addr + 1) :=
    strobe_enters_midByte s (inputs 0) hphase hisrd hbitc hwr
      (hcyc 0 (by decide)).1 (hcyc 0 (by decide)).2
  rw [← stateAt_succ inputs s 0] at h0
  have h1 : MidByte (step (stateAt inputs s 1) (inputs 1)) 2 (s.addr + 1) :=
    midByte_step _ _ 1 _ (by decide) h0 (hcyc 1 (by decide)).1 (hcyc 1 (by decide)).2
      (hack 1 (by decide) (by decide))
  rw [← stateAt_succ inputs s 1] at h1
  have h2 : MidByte (step (stateAt inputs s 2) (inputs 2)) 3 (s.addr + 1) :=
    midByte_step _ _ 2 _ (by decide) h1 (hcyc 2 (by decide)).1 (hcyc 2 (by decide)).2
      (hack 2 (by decide) (by decide))
  rw [← stateAt_succ inputs s 2] at h2
  have h3 : MidByte (step (stateAt inputs s 3) (inputs 3)) 4 (s.addr + 1) :=
    midByte_step _ _ 3 _ (by decide) h2 (hcyc 3 (by decide)).1 (hcyc 3 (by decide)).2
      (hack 3 (by decide) (by decide))
  rw [← stateAt_succ inputs s 3] at h3
  have h4 : MidByte (step (stateAt inputs s 4) (inputs 4)) 5 (s.addr + 1) :=
    midByte_step _ _ 4 _ (by decide) h3 (hcyc 4 (by decide)).1 (hcyc 4 (by decide)).2
      (hack 4 (by decide) (by decide))
  rw [← stateAt_succ inputs s 4] at h4
  have h5 : MidByte (step (stateAt inputs s 5) (inputs 5)) 6 (s.addr + 1) :=
    midByte_step _ _ 5 _ (by decide) h4 (hcyc 5 (by decide)).1 (hcyc 5 (by decide)).2
      (hack 5 (by decide) (by decide))
  rw [← stateAt_succ inputs s 5] at h5
  have h6 : MidByte (step (stateAt inputs s 6) (inputs 6)) 7 (s.addr + 1) :=
    midByte_step _ _ 6 _ (by decide) h5 (hcyc 6 (by decide)).1 (hcyc 6 (by decide)).2
      (hack 6 (by decide) (by decide))
  rw [← stateAt_succ inputs s 6] at h6
  have h7 := midByte_complete (stateAt inputs s 7) (inputs 7) (s.addr + 1) h6
    (hcyc 7 (by decide)).1 (hcyc 7 (by decide)).2 (hack 7 (by decide) (by decide))
  rw [← stateAt_succ inputs s 7] at h7
  exact h7

/-! ## The start of the write data bytes

A write transaction enters `ST_DATA` from `ST_AL` with the loaded address and no
pending strobe.  `ByteStart` is that state.  With no read acknowledgement during
the byte, the first data-byte strobe is at the loaded address and every later
strobe one address higher (`next_data_strobe`), so a clean burst of `k+1` data
bytes writes `base, base+1, ..., base+k`.  A read acknowledgement (`rack` or a
data-RAM landing) also advances `addr`; that is the RTL's `addr_i` equation and
is the reason the burst statement assumes none. -/

/-- Start of a write data byte: no strobe yet, bit count zero, address `a`. -/
def ByteStart (t : State) (a : BitVec 16) : Prop :=
  t.phase = ST_DATA ∧ t.isRd = false ∧ t.bitc = 0 ∧ t.wr = false ∧ t.addr = a

/-- The first rising edge of a data byte starts its bit count; the address does
not move because neither a strobe nor an acknowledgement is present. -/
theorem byteStart_enter (t : State) (i : Input) (a : BitVec 16)
    (h : ByteStart t a) (hreset : i.resetN = true) (hsr : sr i = true)
    (hack : ackBit t i = false) : MidByte (step t i) 1 a := by
  obtain ⟨hphase, hisrd, hbitc, hwr, haddr⟩ := h
  simp only [MidByte, step, phaseNext, bitcNext, rxNext, isRdNext,
    addrNext, wrNext, wdataNext, rdNext, rackNext, cmdNext, completing, sr,
    byteIn, ackBit, addrInc] at hphase hisrd hbitc hwr haddr hreset hsr hack ⊢
  bv_decide

/-- Eight rising edges from the start of a write data byte produce the strobe at
the loaded address, still in `ST_DATA`, not a read, bit count zero. -/
theorem first_data_strobe (inputs : Nat → Input) (s : State) (a : BitVec 16)
    (h : ByteStart s a)
    (hcyc : ∀ j, j < 8 → (inputs j).resetN = true ∧ sr (inputs j) = true)
    (hack : ∀ j, j < 8 → ackBit (stateAt inputs s j) (inputs j) = false) :
    (stateAt inputs s 8).wr = true ∧ (stateAt inputs s 8).addr = a ∧
      (stateAt inputs s 8).phase = ST_DATA ∧ (stateAt inputs s 8).isRd = false ∧
      (stateAt inputs s 8).bitc = 0 := by
  have h0 : MidByte (step (stateAt inputs s 0) (inputs 0)) 1 a :=
    byteStart_enter s (inputs 0) a h (hcyc 0 (by decide)).1 (hcyc 0 (by decide)).2
      (hack 0 (by decide))
  rw [← stateAt_succ inputs s 0] at h0
  have h1 : MidByte (step (stateAt inputs s 1) (inputs 1)) 2 a :=
    midByte_step _ _ 1 _ (by decide) h0 (hcyc 1 (by decide)).1 (hcyc 1 (by decide)).2
      (hack 1 (by decide))
  rw [← stateAt_succ inputs s 1] at h1
  have h2 : MidByte (step (stateAt inputs s 2) (inputs 2)) 3 a :=
    midByte_step _ _ 2 _ (by decide) h1 (hcyc 2 (by decide)).1 (hcyc 2 (by decide)).2
      (hack 2 (by decide))
  rw [← stateAt_succ inputs s 2] at h2
  have h3 : MidByte (step (stateAt inputs s 3) (inputs 3)) 4 a :=
    midByte_step _ _ 3 _ (by decide) h2 (hcyc 3 (by decide)).1 (hcyc 3 (by decide)).2
      (hack 3 (by decide))
  rw [← stateAt_succ inputs s 3] at h3
  have h4 : MidByte (step (stateAt inputs s 4) (inputs 4)) 5 a :=
    midByte_step _ _ 4 _ (by decide) h3 (hcyc 4 (by decide)).1 (hcyc 4 (by decide)).2
      (hack 4 (by decide))
  rw [← stateAt_succ inputs s 4] at h4
  have h5 : MidByte (step (stateAt inputs s 5) (inputs 5)) 6 a :=
    midByte_step _ _ 5 _ (by decide) h4 (hcyc 5 (by decide)).1 (hcyc 5 (by decide)).2
      (hack 5 (by decide))
  rw [← stateAt_succ inputs s 5] at h5
  have h6 : MidByte (step (stateAt inputs s 6) (inputs 6)) 7 a :=
    midByte_step _ _ 6 _ (by decide) h5 (hcyc 6 (by decide)).1 (hcyc 6 (by decide)).2
      (hack 6 (by decide))
  rw [← stateAt_succ inputs s 6] at h6
  have h7 := midByte_complete (stateAt inputs s 7) (inputs 7) a h6
    (hcyc 7 (by decide)).1 (hcyc 7 (by decide)).2 (hack 7 (by decide))
  rw [← stateAt_succ inputs s 7] at h7
  exact h7

/-- The completing `ST_AL` edge enters the first data byte with the loaded
address.  For a write transaction (`isRd = false`) the next state is a
`ByteStart`. -/
theorem al_enters_byteStart (s : State) (i : Input)
    (hphase : s.phase = ST_AL) (hbitc : s.bitc = 7) (hisrd : s.isRd = false)
    (hreset : i.resetN = true) (hcs : i.csN = false) (hsck : i.sck = true)
    (hsp : i.sckPrev = false) :
    ByteStart (step s i) ((addrInc s i >>> 8).truncate 8 ++ byteIn s i) := by
  simp only [ByteStart, step, phaseNext, bitcNext, rxNext, isRdNext, addrNext,
    wrNext, wdataNext, rdNext, rackNext, cmdNext, completing, sr, byteIn, ackBit,
    addrInc] at hphase hbitc hisrd hreset hcs hsck hsp ⊢
  bv_decide

/-- Splitting a sampled trace at cycle `m`. -/
theorem stateAt_add (inputs : Nat → Input) (initial : State) (m n : Nat) :
    stateAt inputs initial (m + n) =
      stateAt (fun j => inputs (m + j)) (stateAt inputs initial m) n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    calc
      stateAt inputs initial (m + (n + 1))
          = stateAt inputs initial ((m + n) + 1) := by rw [Nat.add_succ]
      _ = step (stateAt inputs initial (m + n)) (inputs (m + n)) :=
            stateAt_succ inputs initial (m + n)
      _ = step (stateAt (fun j => inputs (m + j)) (stateAt inputs initial m) n)
              (inputs (m + n)) := by rw [ih]
      _ = step (stateAt (fun j => inputs (m + j)) (stateAt inputs initial m) n)
              ((fun j => inputs (m + j)) n) := rfl
      _ = stateAt (fun j => inputs (m + j)) (stateAt inputs initial m) (n + 1) :=
            (stateAt_succ (fun j => inputs (m + j)) (stateAt inputs initial m) n).symm

/-- A clean write burst of `k+1` data bytes: strobe `j` is at the loaded address
plus `j`.  The `ackBit` hypothesis is what the RTL needs; an acknowledgement also
advances `addr`. -/
theorem data_strobe_index (inputs : Nat → Input) (s : State) (a : BitVec 16)
    (k : Nat) (h : ByteStart s a)
    (hcyc : ∀ j, j < 8 * (k + 1) → (inputs j).resetN = true ∧ sr (inputs j) = true)
    (hack : ∀ j, j < 8 * (k + 1) → ackBit (stateAt inputs s j) (inputs j) = false) :
    (stateAt inputs s (8 * (k + 1))).wr = true ∧
      (stateAt inputs s (8 * (k + 1))).addr = a + (k : BitVec 16) ∧
      (stateAt inputs s (8 * (k + 1))).phase = ST_DATA ∧
      (stateAt inputs s (8 * (k + 1))).isRd = false ∧
      (stateAt inputs s (8 * (k + 1))).bitc = 0 := by
  induction k with
  | zero =>
    simpa using first_data_strobe inputs s a h
      (fun j hj => hcyc j (by simpa using hj))
      (fun j hj => hack j (by simpa using hj))
  | succ k ih =>
    obtain ⟨ihwr, ihaddr, ihphase, ihisrd, ihbitc⟩ :=
      ih (fun j hj => hcyc j (by omega)) (fun j hj => hack j (by omega))
    have hshift : stateAt inputs s (8 * (Nat.succ k + 1)) =
        stateAt (fun j => inputs (8 * (k + 1) + j))
          (stateAt inputs s (8 * (k + 1))) 8 := by
      rw [show 8 * (Nat.succ k + 1) = 8 * (k + 1) + 8 from rfl]
      exact stateAt_add inputs s (8 * (k + 1)) 8
    rw [hshift]
    obtain ⟨nwr, naddr, nphase, nisrd, nbitc⟩ :=
      next_data_strobe (fun j => inputs (8 * (k + 1) + j))
        (stateAt inputs s (8 * (k + 1))) ihphase ihisrd ihbitc ihwr
        (fun j hj => hcyc (8 * (k + 1) + j) (by omega))
        (fun j hj0 hj8 => by
          rw [← stateAt_add inputs s (8 * (k + 1)) j]
          exact hack (8 * (k + 1) + j) (by omega))
    refine ⟨nwr, ?_, nphase, nisrd, nbitc⟩
    rw [naddr, ihaddr, BitVec.add_assoc]
    congr 1
    rw [BitVec.natCast_eq_ofNat, BitVec.natCast_eq_ofNat]
    change BitVec.ofNat 16 k + BitVec.ofNat 16 1 = BitVec.ofNat 16 (k + 1)
    rw [← BitVec.ofNat_add]

/-- The same burst stated from the completing `ST_AL` edge: the loaded address is
the base and strobe `j` is `base + j`.  This composes `al_enters_byteStart` with
`data_strobe_index` on the shifted trace. -/
theorem trace_al_burst_index (inputs : Nat → Input) (initial : State) (n k : Nat)
    (hphase : (stateAt inputs initial n).phase = ST_AL)
    (hbitc : (stateAt inputs initial n).bitc = 7)
    (hisrd : (stateAt inputs initial n).isRd = false)
    (hreset : (inputs n).resetN = true) (hcs : (inputs n).csN = false)
    (hsck : (inputs n).sck = true) (hsp : (inputs n).sckPrev = false)
    (hcyc : ∀ j, j < 8 * (k + 1) →
      (inputs (n + 1 + j)).resetN = true ∧ sr (inputs (n + 1 + j)) = true)
    (hack : ∀ j, j < 8 * (k + 1) →
      ackBit (stateAt inputs initial (n + 1 + j)) (inputs (n + 1 + j)) = false) :
    (stateAt inputs initial (n + 1 + 8 * (k + 1))).wr = true ∧
      (stateAt inputs initial (n + 1 + 8 * (k + 1))).addr =
        ((addrInc (stateAt inputs initial n) (inputs n) >>> 8).truncate 8 ++
          byteIn (stateAt inputs initial n) (inputs n)) + (k : BitVec 16) := by
  have hbase : ByteStart (stateAt inputs initial (n + 1))
      ((addrInc (stateAt inputs initial n) (inputs n) >>> 8).truncate 8 ++
        byteIn (stateAt inputs initial n) (inputs n)) := by
    rw [stateAt_succ]
    exact al_enters_byteStart _ _ hphase hbitc hisrd hreset hcs hsck hsp
  rw [stateAt_add inputs initial (n + 1) (8 * (k + 1))]
  have hindex := data_strobe_index (fun j => inputs (n + 1 + j))
    (stateAt inputs initial (n + 1)) _ k hbase
    (fun j hj => hcyc j hj)
    (fun j hj => by
      rw [← stateAt_add inputs initial (n + 1) j]
      exact hack j hj)
  exact ⟨hindex.1, hindex.2.1⟩

/-! ## The host cut's projection is this machine

`Metronome.Host` keeps `wr` and `bitc` and takes `st`/`is_rd` as free inputs.
Here those inputs are the register values of this machine. -/

theorem wrNext_eq_host (s : State) (i : Input) :
    wrNext s i = Host.wrNext ⟨s.wr, s.bitc⟩
      ⟨i.resetN, i.sck, i.sckPrev, i.csN, s.phase, s.isRd⟩ := by
  simp only [wrNext, Host.wrNext, completing, sr]
  bv_decide

theorem bitcNext_eq_host (s : State) (i : Input) :
    bitcNext s i = Host.bitcNext ⟨s.wr, s.bitc⟩
      ⟨i.resetN, i.sck, i.sckPrev, i.csN, s.phase, s.isRd⟩ := by
  simp only [bitcNext, Host.bitcNext, sr]
  bv_decide

/-- The host-link inputs of this machine's trace. -/
def hostInputs (inputs : Nat → Input) (initial : State) : Nat → Host.Input :=
  fun n => ⟨(inputs n).resetN, (inputs n).sck, (inputs n).sckPrev, (inputs n).csN,
            (stateAt inputs initial n).phase, (stateAt inputs initial n).isRd⟩

/-- The host cut state at cycle 0. -/
def hostInitial (initial : State) : Host.State := ⟨initial.wr, initial.bitc⟩

/-- The `wr`/`bitc` trace of this machine is exactly `Metronome.Host`'s trace on
the register values it treats as free inputs. -/
theorem host_stateAt (inputs : Nat → Input) (initial : State) (n : Nat) :
    Host.stateAt (hostInputs inputs initial) (hostInitial initial) n =
      ⟨(stateAt inputs initial n).wr, (stateAt inputs initial n).bitc⟩ := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Host.stateAt_succ, stateAt_succ, ih]
    simp only [Host.step, step, wrNext_eq_host, bitcNext_eq_host, hostInputs]

/-- The composed filter value of `Metronome.Compose` with this machine's
`wr`. -/
def topHostValid (inCfg live : Nat → Bool) (inputs : Nat → Input) (initial : State)
    (n : Nat) : Bool :=
  Compose.chipHostValid (stateAt inputs initial n).wr (inCfg n) (live n)

theorem compose_topHostValid (inputs : Nat → Input) (initial : State)
    (inCfg live : Nat → Bool) (n : Nat) :
    Compose.topHostValid (hostInputs inputs initial) (hostInitial initial) inCfg live n =
      topHostValid inCfg live inputs initial n := by
  simp only [Compose.topHostValid, topHostValid, host_stateAt]

/-- The configuration input trace of `Metronome.Config` whose `hostValid` comes
from this machine's write strobe and the chip-top filter. -/
def configInputs (rest : Nat → Config.Input) (inCfg live : Nat → Bool)
    (inputs : Nat → Input) (initial : State) : Nat → Config.Input :=
  fun n => { rest n with hostValid := topHostValid inCfg live inputs initial n }

/-- Adjacent host writes are spaced: the Composed `SpacedHost` premise holds for
the trace built from this machine, so `st`/`is_rd` are no longer free.  The only
premise is the reset-state start (cycle 0's `wr` is the arbitrary power-up
value otherwise). -/
theorem spaced_of_hostcmd (rest : Nat → Config.Input) (inCfg live : Nat → Bool)
    (inputs : Nat → Input) (initial : State) (cleared : initial.wr = false) :
    Config.SpacedHost (configInputs rest inCfg live inputs initial) := by
  have host := Compose.spaced_of_top rest (hostInputs inputs initial)
    (hostInitial initial) inCfg live (by simpa [hostInitial] using cleared)
  intro n valid
  have := host n (by simpa [configInputs, Compose.withTopHostValid, compose_topHostValid] using valid)
  simpa [configInputs, Compose.withTopHostValid, compose_topHostValid] using this

/-- The configuration service contract of `Metronome.Config`, with the host
`st`/`is_rd` inputs supplied by this machine's registers and the spacing premise
discharged here. -/
theorem config_host_service_from_hostcmd (rest : Nat → Config.Input)
    (inCfg live : Nat → Bool) (inputs : Nat → Input) (initial : State)
    (cfgInitial : Config.State) (n : Nat) (cleared : initial.wr = false)
    (reset : (configInputs rest inCfg live inputs initial 0).resetN = false)
    (active : (configInputs rest inCfg live inputs initial (n + 1)).resetN = true)
    (valid : (configInputs rest inCfg live inputs initial (n + 1)).hostValid = true) :
    let ins := configInputs rest inCfg live inputs initial
    let state := Config.stateAt ins cfgInitial (n + 1)
    let input := ins (n + 1)
    if state.previousWrite then
      (Config.step state input).bankWrite = false ∧
        ((ins (n + 2)).resetN = true →
          Config.HostIssued
            (Config.step (Config.stateAt ins cfgInitial (n + 2)) (ins (n + 2)))
            input.host)
    else Config.HostIssued (Config.step state input) input.host :=
  Config.trace_host_service (configInputs rest inCfg live inputs initial) cfgInitial reset
    (spaced_of_hostcmd rest inCfg live inputs initial cleared) n active valid

end Metronome.HostCmd
