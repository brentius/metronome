import Metronome.Moves

/-!
# The elaborated move resolution against `Metronome.Moves`

Generated by `lean/moves_check.py` from the Yosys RTLIL of
`{{TOP}}`.  The cones are extracted as Lean functions of named free inputs and
proved equal to the specification in `Metronome.Moves`:

* `rtlGrpV` is `grp[k] = DG_MAP[5*c_dst[6*k +: 6] +: 5]` for the six slots, and
  the elaborated table is `machine.json`'s;
* `rtlValid`, `rtlWin` and `rtlConflictEv` are `mv_valid`, `mv_win` and
  `conflict_ev`, against the spec's validity, key blocking and conflict event;
* `rtlConflictStep` and `rtlMemhazStep` are the two sticky registers, with the
  host `CTRL.STICKY` clear bits 0 and 1;
* `rtlInvStep`, `rtlRdHin`, `rtlRdPd`, `rtlMemhazEv` are the two source side
  effects (a `HOST.IN` read clears `INV`, a `P0.D` read while `!RDY` raises
  `MEMHAZ`);
* `rtlSticky` is the `CTRL.STICKY` write strobe.

What stays free: `mv_en`, `c_dst`, `c_src`, `c_dat` and the cores' `xl` / `xt`
outputs (the core pipeline and dispatch are other cuts), the host strobe `h_wr`
and address `ha` (the host cut), the RAM's `p_haz` / `p_rdy` (the memory cut),
and `c_wr_hin` (the host-map cut, re-established here for the `STICKY` byte).
-/

set_option autoImplicit false
set_option exponentiation.threshold 1024
set_option maxHeartbeats 8000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Metronome.Moves

open Metronome.CoreCtl (bitAt slice)

-- Generated from Yosys RTLIL. SHA-256 of the RTL snapshot: {{FINGERPRINT}}

/-- The 64-code destination → write-group table derived from
`code/md2/machine.json` (`dst` order, `write_groups` order, codes 61..63
unused). -/
abbrev machineTable : BitVec 320 := {{MACHINE_TABLE}}

/-- `HA_CTRL_BASE + HO_CTRL_STICKY`: the `CTRL.STICKY` byte of the host map. -/
abbrev stickyAddr : BitVec 16 := {{STICKY_ADDR}}

/-- The specification's transcribed table and `machine.json` agree. -/
theorem machineTable_spec : machineTable = dgMapLiteral := by decide

/-! ## The destination → group map -/

/-- The elaborated `grp_v`: the six `DG_MAP` lookups, packed
`{grp[5], …, grp[0]}`. -/
def rtlGrpV (dst : BitVec 36) : BitVec 30 :=
{{MAP_LINES}}
  {{MAP_EXPR}}

/-- The elaborated lookup is the `machine.json` table for every destination
bus.  The map is a 320-bit `$shiftx` by `5*d`; the adapter requires the 32-bit
product to fit, so the index is the `Nat` product and the two sides have the
same shift form. -/
theorem rtlGrpV_spec (dst : BitVec 36) : rtlGrpV dst = mapOfWith machineTable dst := by
  rfl

/-- With the specification's own table, the elaborated lookup is `mapOf`. -/
theorem rtlGrpV_mapOf (dst : BitVec 36) : rtlGrpV dst = mapOf dst := by
  rw [rtlGrpV_spec, machineTable_spec]
  rfl

/-! ## Validity, winners and the conflict event -/

/-- The elaborated `mv_valid`: enabled and the group is not `DG_NONE`. -/
def rtlValid (en : BitVec 6) (grp : BitVec 30) : BitVec 6 :=
{{VALID_LINES}}
  {{VALID_EXPR}}

/-- `mv_valid` is the specification's six validity bits. -/
theorem rtlValid_spec (en : BitVec 6) (grp : BitVec 30) :
    rtlValid en grp = validBits en grp := by
  simp only [rtlValid, validBits, bits6, arbBundle, bundleOf, Bundle.get, validAt, dgNone,
    bitAt, slice]
  bv_decide

/-- The elaborated `mv_win`: valid and not blocked by an earlier valid move with
the same key. -/
def rtlWin (en : BitVec 6) (grp : BitVec 30) (xl : BitVec 4) (xt : BitVec 6) : BitVec 6 :=
{{WIN_LINES}}
  {{WIN_EXPR}}

/-- `mv_win` is exactly SPEC_V2 §6's "valid and no earlier valid slot with the
same key", for all six slots. -/
theorem rtlWin_spec (en : BitVec 6) (grp : BitVec 30) (xl : BitVec 4) (xt : BitVec 6) :
    rtlWin en grp xl xt = winBits en grp xl xt := by
  simp only [rtlWin, winBits, bits6, winAt, blocked_zero, blocked_one, blocked_two,
    blocked_three, blocked_four, blocked_five, arbBundle, bundleOf, Bundle.get, validAt,
    sameKey, dgNone, dgLSym, dgTStop, bitAt, slice]
  bv_decide

/-- The elaborated `conflict_ev = |(mv_valid & ~mv_win)`. -/
def rtlConflictEv (en : BitVec 6) (grp : BitVec 30) (xl : BitVec 4) (xt : BitVec 6) : Bool :=
{{EV_LINES}}
  {{EV_EXPR}}

/-- `conflict_ev` is the specification's conflict event: some valid move did not
win, which is exactly two valid moves with one key. -/
theorem rtlConflictEv_spec (en : BitVec 6) (grp : BitVec 30) (xl : BitVec 4) (xt : BitVec 6) :
    rtlConflictEv en grp xl xt = conflictOf en grp xl xt := by
  simp only [rtlConflictEv, conflictOf, conflictEv_six, winAt, blocked_zero, blocked_one,
    blocked_two, blocked_three, blocked_four, blocked_five, arbBundle, bundleOf,
    Bundle.get, validAt, sameKey, dgNone, dgLSym, dgTStop, bitAt, slice]
  bv_decide

/-! ## The sticky `CTRL.STICKY` bits

`CONFLICT` is bit 0 and `MEMHAZ` bit 1 (SPEC_V2 §13.1's `CTRL.STICKY` layout,
`{5'd0, cw_overrun, memhaz, conflict}` in the RTL readback). -/

/-- The elaborated `CTRL.STICKY` write strobe `c_wr_stk`. -/
def rtlSticky (wr : Bool) (ha : BitVec 16) : Bool :=
{{STICKY_LINES}}
  {{STICKY_EXPR}}

/-- `c_wr_stk` is a host write to the `CTRL.STICKY` byte. -/
theorem rtlSticky_spec (wr : Bool) (ha : BitVec 16) :
    rtlSticky wr ha = (wr && (ha == stickyAddr)) := by
  simp only [rtlSticky]
  bv_decide

/-- The elaborated `CONFLICT` next state. -/
def rtlConflictStep (state resetN ev stk : Bool) (hd : BitVec 8) : Bool :=
{{CONFLICT_LINES}}
  {{CONFLICT_EXPR}}

/-- The elaborated `CONFLICT` register is the sticky step with the clear being a
`CTRL.STICKY` write with bit 0. -/
theorem rtlConflictStep_spec (state resetN ev stk : Bool) (hd : BitVec 8) :
    rtlConflictStep state resetN ev stk hd =
      stickyNext state ⟨resetN, ev, stk && bitAt hd 0⟩ := by
  rfl

/-- Reset clears `CONFLICT`, an event sets it, a clear-only cycle (`CTRL.STICKY`
write with bit 0, i.e. `hd = 1`) clears it, and an event beats a simultaneous
clear. -/
theorem rtl_conflict_sticky (state : Bool) :
    rtlConflictStep state false true true 0 = false ∧
      rtlConflictStep state true true true 0 = true ∧
      rtlConflictStep true true false true 1 = false ∧
      rtlConflictStep false true true true 0 = true := by
  cases state <;> decide

/-- The elaborated `MEMHAZ` next state. -/
def rtlMemhazStep (state resetN ev stk : Bool) (hd : BitVec 8) : Bool :=
{{MEMHAZ_LINES}}
  {{MEMHAZ_EXPR}}

/-- The elaborated `MEMHAZ` register is the same sticky step with bit 1. -/
theorem rtlMemhazStep_spec (state resetN ev stk : Bool) (hd : BitVec 8) :
    rtlMemhazStep state resetN ev stk hd =
      stickyNext state ⟨resetN, ev, stk && bitAt hd 1⟩ := by
  rfl

/-- The elaborated `memhaz_ev` term. -/
def rtlMemhazEv (haz ready : Bool) (rdPd : BitVec 6) : Bool :=
{{MEMHAZ_EV_LINES}}
  {{MEMHAZ_EV_EXPR}}

/-- `memhaz_ev` is `p_haz | (|rd_pd & ~p_rdy)`. -/
theorem rtlMemhazEv_spec (haz ready : Bool) (rdPd : BitVec 6) :
    rtlMemhazEv haz ready rdPd = memhazEventOf rdPd haz ready := by
  simp only [rtlMemhazEv, memhazEventOf]
  bv_decide

/-! ## The source side effects -/

/-- The elaborated `rd_hin`: the enabled moves that read `HOST.IN`. -/
def rtlRdHin (en : BitVec 6) (src : BitVec 36) : BitVec 6 :=
{{HIN_LINES}}
  {{HIN_EXPR}}

/-- A move reads `HOST.IN` only when it is enabled, and exactly then. -/
theorem rtlRdHin_spec (en : BitVec 6) (src : BitVec 36) :
    rtlRdHin en src = readsOf en src srcHostIn := by
  simp only [rtlRdHin, readsOf, bits6, readAt, bitAt, slice, srcHostIn]
  bv_decide

/-- The elaborated `rd_pd`: the enabled moves that read `P0.D`. -/
def rtlRdPd (en : BitVec 6) (src : BitVec 36) : BitVec 6 :=
{{PD_LINES}}
  {{PD_EXPR}}

/-- A move reads `P0.D` only when it is enabled, and exactly then. -/
theorem rtlRdPd_spec (en : BitVec 6) (src : BitVec 36) :
    rtlRdPd en src = readsOf en src srcP0D := by
  simp only [rtlRdPd, readsOf, bits6, readAt, bitAt, slice, srcP0D]
  bv_decide

/-- The elaborated `INV` next state. -/
def rtlInvStep (state resetN hostWrite : Bool) (rdHin : BitVec 6) : Bool :=
{{INV_LINES}}
  {{INV_EXPR}}

/-- The elaborated `INV` register matches SPEC_V2 §6: reset clears, a host
`HOSTIN` write sets, a `HOST.IN` read (only an enabled move) clears, otherwise
it holds. -/
theorem rtlInvStep_spec (state resetN hostWrite : Bool) (rdHin : BitVec 6) :
    rtlInvStep state resetN hostWrite rdHin =
      invNext state resetN hostWrite (!(rdHin == 0)) := by
  simp only [rtlInvStep, invNext]
  bv_decide

/-- A `HOST.IN` read with no host write clears `INV`; the read is some enabled
move's. -/
theorem rtl_inv_read (state : Bool) (en : BitVec 6) (src : BitVec 36) :
    rtlInvStep state true false (rtlRdHin en src) =
      (if enabledRead en src srcHostIn then false else state) := by
  rw [rtlInvStep_spec, rtlRdHin_spec]
  rfl

/-- A `P0.D` read while `!RDY` raises the `MEMHAZ` event term, and the term is
the `rd_pd` bus's. -/
theorem rtl_memhaz_read (en : BitVec 6) (src : BitVec 36) (haz : Bool) :
    rtlMemhazEv haz false (rtlRdPd en src) =
      memhazEvent en src haz false := by
  rw [rtlMemhazEv_spec, rtlRdPd_spec]
  rfl

/-! ## Axiom audit

`moves_check.py` records these lines and rejects any use of `sorryAx`. -/

#print axioms machineTable_spec
#print axioms rtlGrpV_spec
#print axioms rtlValid_spec
#print axioms rtlWin_spec
#print axioms rtlConflictEv_spec
#print axioms rtlSticky_spec
#print axioms rtlConflictStep_spec
#print axioms rtl_conflict_sticky
#print axioms rtlMemhazStep_spec
#print axioms rtlMemhazEv_spec
#print axioms rtlRdHin_spec
#print axioms rtlRdPd_spec
#print axioms rtlInvStep_spec
#print axioms rtl_inv_read
#print axioms rtl_memhaz_read

#print axioms winAt_spec
#print axioms winners_unique
#print axioms conflictEv_iff_pairs
#print axioms pick_is_winner_0
#print axioms pick_is_winner_5
#print axioms sticky_event_beats_clear
#print axioms trace_sticky_low
#print axioms memhaz_of_read

end Metronome.Moves
