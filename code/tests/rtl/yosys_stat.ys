# Yosys generic synthesis estimate of tt_um_brentius_metronome with the memory wrappers black-boxed.
# Run from the repository root: yosys -q -l <log> code/tests/rtl/yosys_stat.ys
read_verilog -lib -DSYNTHESIS src/prog_mem.v src/data_mem.v
read_verilog -DSYNTHESIS -Isrc src/md_sync.v src/md_wgroup.v src/md_flags.v src/md_acc.v src/md_shifter.v src/md_counter.v src/md_lfsr.v src/md_beatgen.v src/md_engine.v src/md_core.v src/md_movebus.v src/md_ptrs.v src/md_ctrl.v src/md_spi.v src/md_outcell.v src/md_layout_check.v src/project.v
synth -top tt_um_brentius_metronome
tee -o code/tests/rtl/sim_build/yosys_stat.txt stat
