# Library score: DMX512-A (ANSI E1.11), one direction (controller to fixtures), RS-485 differential pair omitted: this is
# the single-ended data wire a transceiver would drive.  250 kbit/s, 8N2: start bit 0, eight data bits LSB first,
# two stop bits.  Packet: BREAK (>= 92 us low), MAB (>= 12 us high), start code 0x00, then the channel slots.
# This version sends four channel slots; more slots are more `slot` terms (`slot x N` is valid language, but scorec
# 2026-11-16 miscounts a repeated production whose steps merge, so the slots are written out).
# Does not: the receiver side, mark-before-break timing between packets, or alternate start codes.
protocol dmx512
roles    sender, fixture

wire dmx out push-pull idle high by sender

clock 250 kHz
  sender:  generated
  fixture: started by dmx fall
  tolerance 3%

symbols
  bit(d)   dmx "d"          sample dmx at 50%
  brk      dmx "0"                    # 25 beats = 100 us low
  mab      dmx "1"                    # 3 beats = 12 us high

bits lsb first

grammar
  line   = packet*
  packet = brk5 brk5 brk5 brk5 brk5          # 25 beats of break, written out: `brk x 25` hits a scorec repeat bug
           mab mab mab
           bit(0)  const 00  bit(1) bit(1)          # start code 0x00 (null start code, dimmer data follows)
           slot slot slot slot                      # `slot x 4` hits the same scorec repeat bug
           gap 0 beats
  slot   = bit(0) ch:u8 bit(1) bit(1)
  brk5   = brk brk brk brk brk
