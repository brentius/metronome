# Library score: HDLC / SDLC-style synchronous frame (ISO 13239 framing, bit-synchronous, NRZ with a separate bit clock).
# Flag 0x7E, address, control, four information bytes, 16-bit FCS (CRC-16/X-25: poly 0x1021, init 0xFFFF, reflected,
# xorout 0xFFFF, sent low byte first), flag.  Zero-bit insertion after five consecutive 1s between the flags; the
# flags themselves are not stuffed (symbol terminals bypass coding, spec 6).  Bits go out LSB first.
# Data is valid on the rising edge of `clk`.  Does: transparency (stuffing) and the FCS.  Does not: abort sequence (7+
# ones), idle-flag fill between frames, NRZI, a variable information length (`info:bytes[4]`).
protocol hdlc
roles    sender, receiver
use      std

wire clk out push-pull idle low by sender
wire d   out push-pull idle low by sender

clock 1 MHz
  sender:   generated
  receiver: follow clk fall, capture on clk rise
  split 50%

symbols
  bit(v)   clk "01"  d "v"     sample d at clk rise
  idle     clk "0"   d "0"

bits lsb first, stuff 0 after 5 ones

crc crc16_x25 width 16 poly 0x1021 init 0xFFFF refin refout xorout 0xFFFF

grammar
  link   = frame*
  frame  = flag
           addr:u8
           ctrl:u8
           info:bytes[4]
           fcs: crc crc16_x25 over addr..info lsb first
           flag
  flag   = bit(0) bit(1) bit(1) bit(1) bit(1) bit(1) bit(1) bit(0)
