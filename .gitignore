# Submission repository: keep the Tiny Tapeout project and the source, tests,
# models and technical documentation supporting the Jane Street entry.
# New top-level paths are private by default; add an exception when needed.
/*
!/.gitignore
!/.github/
!/.devcontainer/
!/LICENSE
!/README.md
!/info.yaml
!/requirements.txt
!/librelane_plugin_sram_pdn.py
!/odb_stripes.py
!/src/
!/test/
!/docs/
!/wiki/
!/code/
!/sim/

# Local agent instructions, planning records and editor settings.
/BOTS/
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/
/.codex/
/.vscode/
/.idea/
AGENTS.md
CLAUDE.md
plans/
planning/
PLAN.md
PLANS.md
STATUS.md
DECISIONS.md
*_PLAN.md
*_plan.md
*-plan.md

# Local build workspaces, downloaded tools/PDKs and raw/derived run archives.
# Preserve these on disk. Already tracked files require a separate index change.
/build/
/data/
/code/.build/
/code/.tools/

# Python environments, caches and package output.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Simulator/formal output; retain test source, SRAM models and proof inputs.
sim_build*/
results*.xml
*.vcd
*.vvp
*.fst
*.fst.hier
*.log
/code/tests/formal/*_prove/
/code/tests/formal/*_cover/

# Tiny Tapeout/LibreLane generated configuration and physical-build products.
runs/
tt_submission/
/src/user_config.json
/src/config_merged.json
/test/gate_level_netlist.v

# FPGA tool output.
*.jou
*.backup.log
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/

# Local credentials and operating-system files.
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini
