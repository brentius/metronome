/-- `conflict_ev` is the specification's conflict event: some valid move did not
win, which is exactly two valid moves with one key. -/
theorem rtlConflictEv_spec (en : BitVec 6) (grp : BitVec 30) (xl : BitVec 4) (xt : BitVec 6) :
    rtlConflictEv en grp xl xt = conflictOf en grp xl xt := by
