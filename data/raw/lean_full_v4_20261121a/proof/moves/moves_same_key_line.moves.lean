/-! ## The sticky `CTRL.STICKY` bits

`CONFLICT` is bit 0 and `MEMHAZ` bit 1 (SPEC_V2 §13.1's `CTRL.STICKY` layout,
`{5'd0, cw_overrun, memhaz, conflict}` in the RTL readback). -/

/-- The elaborated `CTRL.STICKY` write strobe `c_wr_stk`. -/
def rtlSticky (wr : Bool) (ha : BitVec 16) : Bool :=
  let c_wr_stk0 := (ha - (9216 : BitVec 16))
  let c_wr_stk1 := (c_wr_stk0 < (16 : BitVec 16))
  let c_wr_stk2 := wr && c_wr_stk1
  let c_wr_stk3 := (((BitVec.setWidth 32 c_wr_stk0)) == (1 : BitVec 32))
  let c_wr_stk4 := c_wr_stk2 && c_wr_stk3
  c_wr_stk4

/-- `c_wr_stk` is a host write to the `CTRL.STICKY` byte. -/
theorem rtlSticky_spec (wr : Bool) (ha : BitVec 16) :
    rtlSticky wr ha = (wr && (ha == stickyAddr)) := by
  simp only [rtlSticky]
  bv_decide

/-- The elaborated `CONFLICT` next state. -/
def rtlConflictStep (state resetN ev stk : Bool) (hd : BitVec 8) : Bool :=
  let conflict0 := stk && ((BitVec.truncate 1 (BitVec.ushiftRight hd 0)) != 0)
  let conflict1 := !conflict0
  let conflict2 := state && conflict1
  let conflict3 := ev || conflict2
  let conflict4 := (if resetN then conflict3 else false)
  conflict4

/-- The elaborated `CONFLICT` register is the sticky step with the clear being a
`CTRL.STICKY` write with bit 0. -/
theorem rtlConflictStep_spec (state resetN ev stk : Bool) (hd : BitVec 8) :
    rtlConflictStep state resetN ev stk hd =
      stickyNext state ⟨resetN, ev, stk && bitAt hd 0⟩ := by
  rfl

/-- Reset clears `CONFLICT`, an event sets it, a clear-only cycle (`CTRL.STICKY`
write with bit 0, i.e. `hd = 1`) clears it, and an event beats a simultaneous
clear. -/
theorem rtl_conflict_sticky (state : Bool) :
    rtlConflictStep state false true true 0 = false ∧
      rtlConflictStep state true true true 0 = true ∧
      rtlConflictStep true true false true 1 = false ∧
      rtlConflictStep false true true true 0 = true := by
  cases state <;> decide

/-- The elaborated `MEMHAZ` next state. -/
def rtlMemhazStep (state resetN ev stk : Bool) (hd : BitVec 8) : Bool :=
  let memhaz0 := stk && ((BitVec.truncate 1 (BitVec.ushiftRight hd 1)) != 0)
  let memhaz1 := !memhaz0
  let memhaz2 := state && memhaz1
  let memhaz3 := ev || memhaz2
  let memhaz4 := (if resetN then memhaz3 else false)
  memhaz4

/-- The elaborated `MEMHAZ` register is the same sticky step with bit 1. -/
theorem rtlMemhazStep_spec (state resetN ev stk : Bool) (hd : BitVec 8) :
    rtlMemhazStep state resetN ev stk hd =
      stickyNext state ⟨resetN, ev, stk && bitAt hd 1⟩ := by
  rfl

/-- The elaborated `memhaz_ev` term. -/
def rtlMemhazEv (haz ready : Bool) (rdPd : BitVec 6) : Bool :=
  let memhazev0 := ((((BitVec.truncate 1 (BitVec.ushiftRight rdPd 0)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 1)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 2)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 3)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 4)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 5)) != 0)))
  let memhazev1 := !ready
  let memhazev2 := memhazev0 && memhazev1
  let memhazev3 := haz || memhazev2
  memhazev3

/-- `memhaz_ev` is `p_haz | (|rd_pd & ~p_rdy)`. -/
theorem rtlMemhazEv_spec (haz ready : Bool) (rdPd : BitVec 6) :
    rtlMemhazEv haz ready rdPd = memhazEventOf rdPd haz ready := by
  simp only [rtlMemhazEv, memhazEventOf]
  bv_decide

/-! ## The source side effects -/

/-- The elaborated `rd_hin`: the enabled moves that read `HOST.IN`. -/
def rtlRdHin (en : BitVec 6) (src : BitVec 36) : BitVec 6 :=
  let rdhin0 := ((BitVec.truncate 6 (BitVec.ushiftRight src 0)) == (38 : BitVec 6))
  let rdhin1 := ((BitVec.truncate 1 (BitVec.ushiftRight en 0)) != 0) && rdhin0
  let rdhin2 := ((BitVec.truncate 6 (BitVec.ushiftRight src 6)) == (38 : BitVec 6))
  let rdhin3 := ((BitVec.truncate 1 (BitVec.ushiftRight en 1)) != 0) && rdhin2
  let rdhin4 := ((BitVec.truncate 6 (BitVec.ushiftRight src 12)) == (38 : BitVec 6))
  let rdhin5 := ((BitVec.truncate 1 (BitVec.ushiftRight en 2)) != 0) && rdhin4
  let rdhin6 := ((BitVec.truncate 6 (BitVec.ushiftRight src 18)) == (38 : BitVec 6))
  let rdhin7 := ((BitVec.truncate 1 (BitVec.ushiftRight en 3)) != 0) && rdhin6
  let rdhin8 := ((BitVec.truncate 6 (BitVec.ushiftRight src 24)) == (38 : BitVec 6))
  let rdhin9 := ((BitVec.truncate 1 (BitVec.ushiftRight en 4)) != 0) && rdhin8
  let rdhin10 := ((BitVec.truncate 6 (BitVec.ushiftRight src 30)) == (38 : BitVec 6))
  let rdhin11 := ((BitVec.truncate 1 (BitVec.ushiftRight en 5)) != 0) && rdhin10
  ((if rdhin1 then (BitVec.shiftLeft (1 : BitVec 6) 0) else (0 : BitVec 6)) ||| (if rdhin3 then (BitVec.shiftLeft (1 : BitVec 6) 1) else (0 : BitVec 6)) ||| (if rdhin5 then (BitVec.shiftLeft (1 : BitVec 6) 2) else (0 : BitVec 6)) ||| (if rdhin7 then (BitVec.shiftLeft (1 : BitVec 6) 3) else (0 : BitVec 6)) ||| (if rdhin9 then (BitVec.shiftLeft (1 : BitVec 6) 4) else (0 : BitVec 6)) ||| (if rdhin11 then (BitVec.shiftLeft (1 : BitVec 6) 5) else (0 : BitVec 6)))

/-- A move reads `HOST.IN` only when it is enabled, and exactly then. -/
theorem rtlRdHin_spec (en : BitVec 6) (src : BitVec 36) :
    rtlRdHin en src = readsOf en src srcHostIn := by
  simp only [rtlRdHin, readsOf, bits6, readAt, bitAt, slice, srcHostIn]
  bv_decide

/-- The elaborated `rd_pd`: the enabled moves that read `P0.D`. -/
def rtlRdPd (en : BitVec 6) (src : BitVec 36) : BitVec 6 :=
  let rdpd0 := ((BitVec.truncate 6 (BitVec.ushiftRight src 0)) == (33 : BitVec 6))
  let rdpd1 := ((BitVec.truncate 1 (BitVec.ushiftRight en 0)) != 0) && rdpd0
  let rdpd2 := ((BitVec.truncate 6 (BitVec.ushiftRight src 6)) == (33 : BitVec 6))
  let rdpd3 := ((BitVec.truncate 1 (BitVec.ushiftRight en 1)) != 0) && rdpd2
  let rdpd4 := ((BitVec.truncate 6 (BitVec.ushiftRight src 12)) == (33 : BitVec 6))
  let rdpd5 := ((BitVec.truncate 1 (BitVec.ushiftRight en 2)) != 0) && rdpd4
  let rdpd6 := ((BitVec.truncate 6 (BitVec.ushiftRight src 18)) == (33 : BitVec 6))
  let rdpd7 := ((BitVec.truncate 1 (BitVec.ushiftRight en 3)) != 0) && rdpd6
  let rdpd8 := ((BitVec.truncate 6 (BitVec.ushiftRight src 24)) == (33 : BitVec 6))
  let rdpd9 := ((BitVec.truncate 1 (BitVec.ushiftRight en 4)) != 0) && rdpd8
  let rdpd10 := ((BitVec.truncate 6 (BitVec.ushiftRight src 30)) == (33 : BitVec 6))
  let rdpd11 := ((BitVec.truncate 1 (BitVec.ushiftRight en 5)) != 0) && rdpd10
  ((if rdpd1 then (BitVec.shiftLeft (1 : BitVec 6) 0) else (0 : BitVec 6)) ||| (if rdpd3 then (BitVec.shiftLeft (1 : BitVec 6) 1) else (0 : BitVec 6)) ||| (if rdpd5 then (BitVec.shiftLeft (1 : BitVec 6) 2) else (0 : BitVec 6)) ||| (if rdpd7 then (BitVec.shiftLeft (1 : BitVec 6) 3) else (0 : BitVec 6)) ||| (if rdpd9 then (BitVec.shiftLeft (1 : BitVec 6) 4) else (0 : BitVec 6)) ||| (if rdpd11 then (BitVec.shiftLeft (1 : BitVec 6) 5) else (0 : BitVec 6)))

/-- A move reads `P0.D` only when it is enabled, and exactly then. -/
theorem rtlRdPd_spec (en : BitVec 6) (src : BitVec 36) :
    rtlRdPd en src = readsOf en src srcP0D := by
  simp only [rtlRdPd, readsOf, bits6, readAt, bitAt, slice, srcP0D]
  bv_decide

/-- The elaborated `INV` next state. -/
def rtlInvStep (state resetN hostWrite : Bool) (rdHin : BitVec 6) : Bool :=
  let inv0 := ((((BitVec.truncate 1 (BitVec.ushiftRight rdHin 0)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdHin 1)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdHin 2)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdHin 3)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdHin 4)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdHin 5)) != 0)))
  let inv1 := (if inv0 then false else state)
  let inv2 := (if hostWrite then true else inv1)
  let inv3 := (if resetN then inv2 else false)
  inv3

/-- The elaborated `INV` register matches SPEC_V2 §6: reset clears, a host
`HOSTIN` write sets, a `HOST.IN` read (only an enabled move) clears, otherwise
it holds. -/
theorem rtlInvStep_spec (state resetN hostWrite : Bool) (rdHin : BitVec 6) :
    rtlInvStep state resetN hostWrite rdHin =
      invNext state resetN hostWrite (!(rdHin == 0)) := by
  simp only [rtlInvStep, invNext]
  bv_decide

/-- A `HOST.IN` read with no host write clears `INV`; the read is some enabled
move's. -/
theorem rtl_inv_read (state : Bool) (en : BitVec 6) (src : BitVec 36) :
    rtlInvStep state true false (rtlRdHin en src) =
      (if enabledRead en src srcHostIn then false else state) := by
  rw [rtlInvStep_spec, rtlRdHin_spec]
  rfl

/-- A `P0.D` read while `!RDY` raises the `MEMHAZ` event term, and the term is
the `rd_pd` bus's. -/
theorem rtl_memhaz_read (en : BitVec 6) (src : BitVec 36) (haz : Bool) :
    rtlMemhazEv haz false (rtlRdPd en src) =
      memhazEvent en src haz false := by
  rw [rtlMemhazEv_spec, rtlRdPd_spec]
  rfl

