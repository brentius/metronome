; uart_8n1 / receiver: generated by scorec from uart_8n1.score

.clock 60e6

.line 0
    inc 6
    mod 3125
    taps - 1562 -
    preset 18
    edge P0 fall
    pins A=P0
    lut0 0xCCCCCCCC
    lut1 0x00000000
    snap tap1
    ctl arm
.end
.stream 0
    mode rx
    order lsb
    start 1024
    len 992
.end

.thread 0
    core 0
    line 0
    trigger L0.TAP1
    start R1
.end

.core 0
R1:
        when L.IN0 ? #1 -> FLAGS.SET          ; expect bit(0)
        pause
R2:
        L.IN -> S0.RX, #6 -> CNT0.LO   pause          ; capture data: bit 1 of 8
R3l:
        L.IN -> S0.RX, ZERO -> CNT0.DEC   pause goto R3l ifnot CNT0.Z
R4:
        when L.IN0 ! #1 -> FLAGS.SET          ; expect bit(1)
end:
        when HOST.OUTE ? FLAGS.LO -> HOST.OUT          ; frame status to the host mailbox
        #1 -> FLAGS.CLR
        #2 -> L0.CTL          ; stop the line and re-arm for the next start edge (last: the line must keep running, it is what wakes the thread for every tail burst)
        pause goto R1
