; spi_mode0 / peripheral: generated by scorec from spi_mode0.score

.clock 60e6

.line 0
    inc 1
    mod 120
    follow
    edge P1 fall
    t0edge P1 rise
    pins A=P0
    lut0 0xAAAAAAAA
    lut1 0x00000000
    snap tap0
    minperiod 30
    minhalf 15
.end
.line 1
    inc 1
    mod 120
    follow
    edge P1 fall
    pins A=P2
    minperiod 30
    minhalf 15
.end
.out O8                        ; wire 'miso'
    line 1
    sel 0 1 2
    lutraw 0x08080808
.end
.stream 0
    mode tx
    order msb
    start 0
    len 0
.end
.stream 1
    mode rx
    order msb
    start 1024
    len 992
.end
.thread 0
    core 0
    line 1
    trigger L1.BEAT
    start tx
.end
.thread 1
    core 1
    line 0
    trigger L0.TAP0
    start rx
.end
.thread 2
    core 1
    line 1
    trigger PINA.FALL
    start cs_on
.end
.thread 3
    core 0
    line 1
    trigger PINA.RISE
    start cs_off
.end

.core 0
tx:
        when L.PINA ! S0.BIT -> L.DBIT, ! ZERO -> S0.ADV   pause goto tx          ; stage while selected; a queued trailing edge must not consume the rewound stream
cs_off:
        ZERO -> L.SYM, ZERO -> L0.CTL, ZERO -> L1.CTL          ; stage idle and stop both lines before the idle start-commit
        #5 -> L1.CTL          ; start the output line: the start commits the idle symbol
        ZERO -> L1.CTL, #1 -> S0.CTL          ; stop it again; rewind the transmit stream (prefetch next byte)
        pause goto cs_off

.core 1
rx:
        L.IN -> S1.RX   pause goto rx          ; capture the input bit
cs_on:
        #2 -> L.SYM          ; chip select asserted: kind of the data symbol
        S0.BIT -> L.DBIT, ZERO -> S0.ADV, #5 -> L1.CTL          ; output bit 0; start the output line (commit)
        S0.BIT -> L.DBIT, ZERO -> S0.ADV, #5 -> L0.CTL          ; output bit 1; start the input line
        #1 -> S1.CTL          ; rewind the receive stream
        pause goto cs_on
