; spi_mode0 / controller: generated by scorec from spi_mode0.score

.clock 60e6

.line 0
    inc 1
    mod 60
    taps - 30 -
    pins A=P1
    lut0 0xCCCCCCCC
    lut1 0x00000000
    snap tap1
    ctl run
.end
.out O8                        ; wire 'sck'
    line 0
    sel 0 1 2
    lutraw 0x30303000
.end
.out O9                        ; wire 'cs_n'
    line 0
    sel 0 1 2
    lutraw 0xCBCBCBCB
.end
.out O10                        ; wire 'mosi'
    line 0
    sel 0 1 2
    lutraw 0x20202020
.end
.stream 0
    mode tx
    order msb
    start 0
    len 0
.end
.stream 1
    mode rx
    order msb
    start 1024
    len 0
.end

.thread 0
    core 0
    line 0
    trigger L0.BEAT
    start idle
.end
.thread 1
    core 1
    line 0
    trigger L0.TAP1
    start rx
.end

.core 0
frame:
S1:
        #2 -> L.SYM   pause          ; stage select
S2:
        #4 -> L.SYM
        S0.BIT -> L.DBIT, ZERO -> S0.ADV
        pause goto S3l ifnot S0.END
S3l:
        S0.BIT -> L.DBIT, ZERO -> S0.ADV, ZERO -> FLAGS.SET
        pause goto S3l ifnot S0.END
S4:
        ZERO -> L.SYM, ZERO -> FLAGS.SET   pause          ; stage deselect
idle:
        when HOST.INV ZERO -> L.SYM, ZERO -> FLAGS.CLR, ? HOST.IN -> NULL   pause goto frame if HOST.INV          ; idle: stage idle, consume the go byte, start the frame
        pause goto idle          ; idle, second beat (the not-taken path falls here)

.core 1
rx:
        when F0 ? L.IN -> S1.RX   pause goto rx          ; capture while flag 0 (data beats)
