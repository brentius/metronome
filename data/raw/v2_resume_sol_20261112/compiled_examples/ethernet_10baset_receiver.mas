; ethernet_10baset / receiver: generated by scorec from ethernet_10baset.score

.clock 60e6

.line 0
    inc 16
    mod 97
    taps - 49 -
    preset 33
    edge P2 both
    window 0 32
    pins A=P2
    lut0 0xCCCCCCCC
    lut1 0x00000000
    snap beat
    ctl arm ren
.end
.stream 0
    mode rx
    order lsb
    start 1024
    len 992
.end
.lfsr 1 poly=0x4C11DB7 width=32 init=0
.lfsr 0 poly=0x4C11DB7 width=32 init=0xFFFFFFFF

.thread 0
    core 0
    line 0
    trigger L0.BEAT
    start R1
.end
.thread 5
    core 1
    line 0
    trigger ALWAYS
    start init
.end

.core 0
R1:
        L.IN -> LF1.ST, #62 -> CNT0.LO   pause          ; const 64 bits: bit 1 into the signature register
R2l:
        L.IN -> LF1.ST, ZERO -> CNT0.DEC   pause goto R2l ifnot CNT0.Z
R3:
R4l:
        when L.SYNC ? L.IN -> S0.RX, ? L.IN -> LF0.ST   pause goto R4l if L.SYNC          ; body: until a beat with no edge
end:
        LF0.B0 -> ACC.LD   pause
        #227 -> ACC.XOR   pause
        when ACC.Z ! #2 -> FLAGS.SET   pause          ; LFSR state != residue: crc error
        LF0.B1 -> ACC.LD   pause
        #32 -> ACC.XOR   pause
        when ACC.Z ! #2 -> FLAGS.SET   pause          ; LFSR state != residue: crc error
        LF0.B2 -> ACC.LD   pause
        #187 -> ACC.XOR   pause
        when ACC.Z ! #2 -> FLAGS.SET   pause          ; LFSR state != residue: crc error
        LF0.B3 -> ACC.LD   pause
        #222 -> ACC.XOR   pause
        when ACC.Z ! #2 -> FLAGS.SET   pause          ; LFSR state != residue: crc error
        LF1.B0 -> ACC.LD   pause
        #204 -> ACC.XOR   pause
        when ACC.Z ! ZERO -> FLAGS.SET   pause          ; signature of the received const bits != expected
        LF1.B1 -> ACC.LD   pause
        #126 -> ACC.XOR   pause
        when ACC.Z ! ZERO -> FLAGS.SET   pause          ; signature of the received const bits != expected
        LF1.B2 -> ACC.LD   pause
        #74 -> ACC.XOR   pause
        when ACC.Z ! ZERO -> FLAGS.SET   pause          ; signature of the received const bits != expected
        LF1.B3 -> ACC.LD   pause
        #103 -> ACC.XOR   pause
        when ACC.Z ! ZERO -> FLAGS.SET   pause          ; signature of the received const bits != expected
        when HOST.OUTE ? FLAGS.LO -> HOST.OUT   pause          ; frame status to the host mailbox
        #255 -> LF0.B0   pause
        #255 -> LF0.B1   pause
        #255 -> LF0.B2   pause
        #255 -> LF0.B3   pause
        ZERO -> LF1.B0   pause
        ZERO -> LF1.B1   pause
        ZERO -> LF1.B2   pause
        ZERO -> LF1.B3   pause
        ZERO -> FLAGS.CLR   pause
        #2 -> FLAGS.CLR   pause
        #6 -> L0.CTL          ; stop the line and re-arm for the next start edge (last: the line must keep running, it is what wakes the thread for every tail burst)
        pause goto R1

.core 1
init:
        #255 -> LF0.B0
        #255 -> LF0.B1
        #255 -> LF0.B2
        #255 -> LF0.B3
        ZERO -> T.STOP   pause goto init
