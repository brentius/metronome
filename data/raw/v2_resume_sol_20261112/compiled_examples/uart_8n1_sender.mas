; uart_8n1 / sender: generated by scorec from uart_8n1.score

.clock 60e6

.line 0
    inc 6
    mod 3125
    taps - - -
    ctl run
.end
.out O8                        ; wire 'tx'
    line 0
    sel 0 1 2
    lutraw 0xFBFBFBFB
.end

.thread 0
    core 0
    line 0
    trigger L0.BEAT
    start idle
.end

.core 0
frame:
S1:
        #2 -> L.SYM   pause          ; stage bit(0)
after0:
S2:
        HOST.IN -> SH0.LD          ; data: byte from the host mailbox
S3l:
        SH0.O -> L.DBIT, ZERO -> SH0.SH
        pause goto S3l ifnot SH0.DONE
S4:
        #3 -> L.SYM   pause          ; stage bit(1)
idle:
        when HOST.INV ? #2 -> L.SYM, ! ZERO -> L.SYM          ; idle / first symbol
        pause goto after0 if HOST.INV
        pause goto idle          ; idle, second beat (the not-taken path falls here)
