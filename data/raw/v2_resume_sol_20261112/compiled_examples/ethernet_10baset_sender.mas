; ethernet_10baset / sender: generated by scorec from ethernet_10baset.score

.clock 60e6

.line 0
    inc 1
    mod 6
    taps - 3 -
    ctl run
.end
.out O0                        ; wire 'td'
    line 0
    sel 0 1 2
    lutraw 0x24242414
    oeraw 0xFFFFFFFF
.end
.out O1                        ; wire 'tdn'
    line 0
    sel 0 1 2
    lutraw 0xDBDBDBEB
    oeraw 0xFFFFFFFF
.end
.stream 0
    mode tx
    order lsb
    start 0
    len 0
.end
.stream 1
    mode tx
    order lsb
    start 2016
    len 8
.end
.data 2016 0x55 0x55 0x55 0x55 0x55 0x55 0x55 0xD5
.lfsr 0 poly=0x4C11DB7 width=32 init=0xFFFFFFFF

.thread 0
    core 0
    line 0
    trigger L0.BEAT
    start idle
.end
.thread 5
    core 1
    line 0
    trigger ALWAYS
    start init
.end

.core 0
frame:
S1:
        #4 -> L.SYM
S2l:
        S1.BIT -> L.DBIT, ZERO -> S1.ADV
        pause goto S2l ifnot S1.END
S3:
S4l:
        S0.BIT -> L.DBIT, ZERO -> S0.ADV, S0.BIT -> LF0.ST
        pause goto S4l ifnot S0.END
S5:
        #31 -> CNT0.LO
S6l:
        when LF0.OUT ? ZERO -> L.DBIT, ! #1 -> L.DBIT, LF0.O -> LF0.ST
        ZERO -> CNT0.DEC   pause goto S6l ifnot CNT0.Z
S7:
        #2 -> L.SYM          ; stage tpidl x2
        #1 -> CNT0.LO
S8l:
        ZERO -> CNT0.DEC   pause goto S8l ifnot CNT0.Z
S9g:
        ZERO -> L.SYM          ; idle
        #255 -> LF0.B0   pause          ; housekeeping
S10h:
        #255 -> LF0.B1   pause          ; housekeeping
S11h:
        #255 -> LF0.B2   pause          ; housekeeping
S12h:
        #255 -> LF0.B3   pause          ; housekeeping
S13h:
        #1 -> S1.CTL   pause          ; housekeeping
S14c:
        #90 -> CNT0.LO
S15l:
        ZERO -> CNT0.DEC   pause goto S15l ifnot CNT0.Z
idle:
        when HOST.INV ZERO -> L.SYM, ? HOST.IN -> NULL   pause goto frame if HOST.INV          ; idle: stage idle, consume the go byte, start the frame
        pause goto idle          ; idle, second beat (the not-taken path falls here)

.core 1
init:
        #255 -> LF0.B0
        #255 -> LF0.B1
        #255 -> LF0.B2
        #255 -> LF0.B3
        ZERO -> T.STOP   pause goto init
