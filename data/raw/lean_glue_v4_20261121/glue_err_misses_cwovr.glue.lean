/-- The elaborated glue transition. -/
def rtlStep (s : GlueState) (i : GlueInput) : GlueState :=
  {
    runG := rtlRunG s.runG i.wrRun i.hWd i.resetN
    irqEn := rtlIrqEn s.irqEn i.wrIrqEn i.hWd i.resetN
    irq := rtlIrq s.irqEn s.outv i.conflict i.memhaz i.cwOverrun i.tLate i.tOvr i.lTapmiss i.sStarved i.resetN
    db := rtlDb s.db i.wrDb i.hWd i.frz i.resetN
    fl := rtlFl s.fl i.wFlags i.resetN false
    flp := rtlFlp s.flp s.fl i.frz i.resetN
    inB := rtlInB s.inB i.wrHin i.hWd i.resetN
    inv := rtlInv s.inv i.wrHin i.hWd i.rdHin i.resetN
    invp := rtlInvp s.invp s.inv i.frz i.resetN
    outB := rtlOutB s.outB i.wHout i.resetN
    outv := rtlOutv s.outv i.wHout i.wrHst i.hWd i.resetN
  }

/-- The elaborated transition is the specification transition. -/
theorem rtlStep_eq_step (s : GlueState) (i : GlueInput) : rtlStep s i = step s i :=
  GlueState.ext
    (rtlRunG_spec s i)
    (rtlIrqEn_spec s i)
    (rtlIrq_spec s i)
    (rtlDb_spec s i)
    (rtlFl_spec s i false)
    (rtlFlp_spec s i)
    (rtlInB_spec s i)
    (rtlInv_spec s i)
    (rtlInvp_spec s i)
    (rtlOutB_spec s i)
    (rtlOutv_spec s i)

/-- The elaborated register state during cycle `n`. -/
def rtlStateAt (inputs : Nat → GlueInput) (n : Nat) : GlueState :=
  run (fun s i => rtlStep s i) inputs resetState n

/-- The elaborated trace is the specification trace at every cycle. -/
theorem rtlStateAt_eq (inputs : Nat → GlueInput) :
    rtlStateAt inputs = stateAt inputs := by
  funext n
  simp only [rtlStateAt, stateAt]
  exact run_congr (fun s i => rtlStep_eq_step s i) inputs resetState n

/-- Pointwise form of the trace equality. -/
theorem rtl_trace_result (inputs : Nat → GlueInput) (n : Nat) :
    rtlStateAt inputs n = stateAt inputs n := by
  rw [rtlStateAt_eq]

/-- Starting from reset, `IRQ` is low until an `IRQEN` write enables it. -/
theorem rtl_trace_irq_quiet (inputs : Nat → GlueInput) (n : Nat)
    (noReset : ∀ k, k < n → (inputs k).resetN = true)
    (quiet : ∀ k, k < n → (stateAt inputs k).irqEn = 0) :
    (rtlStateAt inputs n).irq = false := by
  rw [rtl_trace_result]
  exact trace_irq_quiet inputs n noReset quiet

/-- A frozen cycle holds `FP` on the elaborated trace (§12.3). -/
theorem rtl_trace_flp_frozen (inputs : Nat → GlueInput) (n : Nat)
    (reset : (inputs n).resetN = true) (frz : (inputs n).frz = true) :
    (rtlStateAt inputs (n + 1)).flp = (rtlStateAt inputs n).flp := by
  rw [rtl_trace_result, rtl_trace_result, stateAt_succ]
  exact flp_frozen_holds _ _ reset frz

/-- A frozen cycle holds a doorbell pulse and adds the written bits on the
elaborated trace (§9, §12.3). -/
theorem rtl_trace_db_frozen (inputs : Nat → GlueInput) (n : Nat)
    (reset : (inputs n).resetN = true) (frz : (inputs n).frz = true) :
    (rtlStateAt inputs (n + 1)).db = ((if (inputs n).wrDb then doorbellBits (inputs n)
      else 0) ||| (rtlStateAt inputs n).db) := by
  rw [rtl_trace_result, rtl_trace_result, stateAt_succ]
  exact db_frozen_hold _ _ reset frz

