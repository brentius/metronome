/-- The three top-level pin buses. -/
def rtlPins (out : BitVec 14) (oe : BitVec 8) (irq miso : Bool) :
    BitVec 8 × BitVec 8 × BitVec 8 :=

  (((if miso then (BitVec.shiftLeft (1 : BitVec 8) 0) else (0 : BitVec 8)) ||| (if irq then (BitVec.shiftLeft (1 : BitVec 8) 1) else (0 : BitVec 8)) ||| (BitVec.shiftLeft (BitVec.setWidth 8 (BitVec.truncate 6 (BitVec.ushiftRight out 8))) 2)),
   (BitVec.truncate 8 (BitVec.ushiftRight out 0)),
   oe)


/-- The pin buses are §8's: `uo_out = {OUT[13:8], IRQ, MISO}`, `uio_out = OUT[7:0]`, `uio_oe = OEN`. -/
theorem rtlPins_spec (out : BitVec 14) (oe : BitVec 8) (irq miso : Bool) :
    rtlPins out oe irq miso = pins out oe irq miso := by
  simp only [rtlPins, pins, bitByte, slice]
  all_goals bv_decide


