/-- Stream-0 `rewind`: the move's `CTL` bit 0 OR the host's. -/
def rtlRewindS0 (w : BitVec 15) (mctl : Bool) (wSrt : Bool) (aSrt : BitVec 16)
    (hd : BitVec 8) : Bool :=
    let ctl0r0 := mctl && ((BitVec.truncate 1 (BitVec.ushiftRight w 0)) != 0)
    let ctl0r1 := (((BitVec.setWidth 16 (BitVec.truncate 14 (BitVec.ushiftRight aSrt 2)))) == (0 : BitVec 16))
    let ctl0r2 := wSrt && ctl0r1
    let ctl0r3 := (((BitVec.setWidth 32 (BitVec.truncate 2 (BitVec.ushiftRight aSrt 0)))) == (2 : BitVec 32))
    let ctl0r4 := ctl0r2 && ctl0r3
    let ctl0r5 := ctl0r4 && ((BitVec.truncate 1 (BitVec.ushiftRight hd 0)) != 0)
    let ctl0r6 := ctl0r0 || ctl0r5
  ctl0r6

/-- `rewind` combines a move to `Sk.CTL` (bit 0 of its data) and a host write
of `SRT.CTL` (bit 0). -/
theorem rtlRewindS0_spec (w : BitVec 15) (mctl : Bool) (wSrt : Bool)
    (aSrt : BitVec 16) (hd : BitVec 8) :
    rtlRewindS0 w mctl wSrt aSrt hd =
      (streamCtlOf (slice w 0 8) mctl (hostCtl wSrt aSrt 0) hd).rewind := by
  simp only [rtlRewindS0, streamCtlOf, hostCtl, slice, bitAt]
  bv_decide

