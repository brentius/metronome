       else if opg en grp dst dgLf1 dLf1B0 then 1
       else if opg en grp dst dgLf1 dLf1B1 then 2
       else if opg en grp dst dgLf1 dLf1B2 then 3 else 4) :=
  lfsrSel_of_opg en grp dst dgLf1 dLf1St dLf1B0 dLf1B1 dLf1B2

/-- `ST` and `B0` of the LFSR-1 never fire together (nor any other pair). -/
theorem lfsrSel1_exclusive (en : BitVec 6) (grp : BitVec 30) (dst : BitVec 36) :
    (opg en grp dst dgLf1 dLf1St && opg en grp dst dgLf1 dLf1B0) = false := by
  apply lfsr_ops_exclusive
  decide

