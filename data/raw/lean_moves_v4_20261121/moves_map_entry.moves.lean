/-! ## The sticky `CTRL.STICKY` bits

`CONFLICT` is bit 0 and `MEMHAZ` bit 1 (SPEC_V2 §13.1's `CTRL.STICKY` layout,
`{5'd0, cw_overrun, memhaz, conflict}` in the RTL readback). -/

/-- The elaborated `CTRL.STICKY` write strobe `c_wr_stk`. -/
def rtlSticky (wr : Bool) (ha : BitVec 16) : Bool :=
  let c_wr_stk0 := (ha - (9216 : BitVec 16))
  let c_wr_stk1 := (c_wr_stk0 < (16 : BitVec 16))
  let c_wr_stk2 := wr && c_wr_stk1
  let c_wr_stk3 := (((BitVec.setWidth 32 c_wr_stk0)) == (1 : BitVec 32))
  let c_wr_stk4 := c_wr_stk2 && c_wr_stk3
  c_wr_stk4

/-- `c_wr_stk` is a host write to the `CTRL.STICKY` byte. -/
theorem rtlSticky_spec (wr : Bool) (ha : BitVec 16) :
    rtlSticky wr ha = (wr && (ha == stickyAddr)) := by
  simp only [rtlSticky]
  bv_decide

/-- The elaborated `CONFLICT` next state. -/
def rtlConflictStep (state resetN ev stk : Bool) (hd : BitVec 8) : Bool :=
  let conflict0 := stk && ((BitVec.truncate 1 (BitVec.ushiftRight hd 0)) != 0)
  let conflict1 := !conflict0
  let conflict2 := state && conflict1
  let conflict3 := ev || conflict2
  let conflict4 := (if resetN then conflict3 else false)
  conflict4

/-- The elaborated `CONFLICT` register is the sticky step with the clear being a
`CTRL.STICKY` write with bit 0. -/
theorem rtlConflictStep_spec (state resetN ev stk : Bool) (hd : BitVec 8) :
    rtlConflictStep state resetN ev stk hd =
      stickyNext state ⟨resetN, ev, stk && bitAt hd 0⟩ := by
  rfl

/-- Reset clears `CONFLICT`, an event sets it, a clear-only cycle (`CTRL.STICKY`
write with bit 0, i.e. `hd = 1`) clears it, and an event beats a simultaneous
clear. -/
theorem rtl_conflict_sticky (state : Bool) :
    rtlConflictStep state false true true 0 = false ∧
      rtlConflictStep state true true true 0 = true ∧
      rtlConflictStep true true false true 1 = false ∧
      rtlConflictStep false true true true 0 = true := by
  cases state <;> decide

/-- The elaborated `MEMHAZ` next state. -/
def rtlMemhazStep (state resetN ev stk : Bool) (hd : BitVec 8) : Bool :=
  let memhaz0 := stk && ((BitVec.truncate 1 (BitVec.ushiftRight hd 1)) != 0)
  let memhaz1 := !memhaz0
  let memhaz2 := state && memhaz1
  let memhaz3 := ev || memhaz2
  let memhaz4 := (if resetN then memhaz3 else false)
  memhaz4

/-- The elaborated `MEMHAZ` register is the same sticky step with bit 1. -/
theorem rtlMemhazStep_spec (state resetN ev stk : Bool) (hd : BitVec 8) :
    rtlMemhazStep state resetN ev stk hd =
      stickyNext state ⟨resetN, ev, stk && bitAt hd 1⟩ := by
  rfl

/-- The elaborated `memhaz_ev` term. -/
def rtlMemhazEv (haz ready : Bool) (rdPd : BitVec 6) : Bool :=
  let memhazev0 := ((((BitVec.truncate 1 (BitVec.ushiftRight rdPd 0)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 1)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 2)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 3)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 4)) != 0)) || (((BitVec.truncate 1 (BitVec.ushiftRight rdPd 5)) != 0)))
